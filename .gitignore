node_modules
# Ignore every env file, then let the templates back in.
#
# The pattern used to be `*.env`, which matches files ENDING in .env and
# therefore never matched .env.production or .env.staging - both of which
# were tracked. They held placeholders, so nothing leaked, but the moment
# someone filled in a real DATABASE_URL or NEXTAUTH_SECRET it would have
# been committed without a word. The committed copies are now
# .env.production.example and .env.staging.example.
.env*
!.env.example
!*.env.example
.DS_Store
build
dist
.next
*.tsbuildinfo

# Capacitor — native build outputs (ios/ and android/ are generated on a
# Mac via `npx cap add`; see docs/MOBILE_SETUP.md)
ios/App/Pods/
ios/App/Podfile.lock
ios/App/App.xcworkspace/xcuserdata/
ios/DerivedData/
android/.gradle/
android/app/build/
android/build/
*.keystore
*.jks

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
*.egg
.pytest_cache/
.coverage
htmlcov/

# Seeded design canvases are ~2 MiB of editor payload rebuilt from the
# .dc.html sources beside them; keep the sources, not the build output.
design-mc/*.html
!design-mc/*.dc.html
