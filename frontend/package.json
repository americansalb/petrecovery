{
  "name": "petrecovery-frontend",
  "version": "1.0.0",
  "description": "PetRecovery Frontend",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf .next && next build",
    "start": "next start -p ${PORT:-3000}",
    "postinstall": "prisma generate && prisma db push --accept-data-loss && npm run seed",
    "seed": "node prisma/seed.js",
    "seed:metros": "node prisma/seed-metro-areas.js",
    "clear:squads": "node prisma/clear-squads.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "next": "^14.0.0",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.0",
    "prisma": "^6.19.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  }
}
