{
  "name": "petrecovery-frontend",
  "version": "1.0.0",
  "description": "PetRecovery Frontend",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf .next && next build",
    "start": "next start -p ${PORT:-3000}",
    "postinstall": "prisma generate && prisma db push --skip-generate --accept-data-loss && npm run seed",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "seed": "node prisma/seed.js",
    "seed:metros": "node prisma/seed-metro-areas.js",
    "clear:squads": "node prisma/clear-squads.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "lint": "next lint",
    "cap:init": "npx cap init ReunitePets com.reunitepets.app --web-dir=out",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "mobile:build": "next build && next export && npx cap sync",
    "mobile:ios": "npm run mobile:build && npx cap open ios",
    "mobile:android": "npm run mobile:build && npx cap open android"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@prisma/client": "^5.10.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^3.0.3",
    "date-fns": "^3.0.0",
    "framer-motion": "^12.23.24",
    "jose": "^6.1.3",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "lucide-react": "^0.555.0",
    "next": "^14.0.0",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.0",
    "postcss": "^8.4.47",
    "prisma": "^5.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "redis": "^4.7.0",
    "resend": "^2.0.0",
    "tailwindcss": "^3.4.14",
    "twilio": "^5.10.6",
    "typescript": "^5.0.0",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.1.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.0.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0"
  }
}
