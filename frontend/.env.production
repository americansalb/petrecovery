# PetRecovery.org - Production Environment Configuration
# CRITICAL: Store actual values in secure secrets manager (AWS Secrets, Vault, etc.)
# This file serves as a template - NEVER commit with real values

# =============================================================================
# DATABASE - Use managed PostgreSQL (AWS RDS, Supabase, etc.)
# =============================================================================
DATABASE_URL="postgresql://petrecovery:PRODUCTION_PASSWORD@prod-db.region.rds.amazonaws.com:5432/petrecovery_prod?sslmode=require"

# =============================================================================
# AUTHENTICATION
# =============================================================================
NEXTAUTH_URL="https://petrecovery.org"
NEXTAUTH_SECRET="PRODUCTION_SECRET_FROM_SECRETS_MANAGER"

# OAuth Providers - Configure for production
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# =============================================================================
# EMAIL - Production email service
# =============================================================================
EMAIL_SERVICE="sendgrid"
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="PetRecovery <noreply@petrecovery.org>"
ADMIN_NOTIFICATION_EMAIL="admin@petrecovery.org"

# =============================================================================
# FILE STORAGE - Production CDN
# =============================================================================
BUNNY_STORAGE_ZONE="petrecovery-prod"
BUNNY_API_KEY=""
BUNNY_CDN_URL="https://cdn.petrecovery.org"
BUNNY_STORAGE_URL="https://storage.bunnycdn.com"

# =============================================================================
# SMS NOTIFICATIONS - Production Twilio
# =============================================================================
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# =============================================================================
# PUSH NOTIFICATIONS
# =============================================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@petrecovery.org"

# =============================================================================
# RATE LIMITING - Production Redis (ElastiCache, Redis Cloud, etc.)
# =============================================================================
REDIS_URL="redis://prod-redis.cache.amazonaws.com:6379"

# =============================================================================
# RECAPTCHA - Production keys
# =============================================================================
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# =============================================================================
# EXTERNAL APIS
# =============================================================================
PETFINDER_API_KEY=""
PETFINDER_API_SECRET=""
GEOCODING_API_KEY=""

# =============================================================================
# ERROR TRACKING - Production Sentry
# =============================================================================
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG="petrecovery"
SENTRY_PROJECT="petrecovery-production"

# =============================================================================
# FEATURE FLAGS - Production features
# =============================================================================
ENABLE_SMS_NOTIFICATIONS="true"
ENABLE_PUSH_NOTIFICATIONS="true"
ENABLE_SHELTER_INTEGRATION="true"

# =============================================================================
# DEPLOYMENT
# =============================================================================
NEXT_PUBLIC_BASE_URL="https://www.reunitepets.org"
NODE_ENV="production"
