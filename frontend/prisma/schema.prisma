// Cached terrain data from OpenStreetMap
model TerrainCache {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  expiresAt DateTime

  // Location identifier (grid cell)
  centerLatitude  Float
  centerLongitude Float
  radiusMiles     Float

  // Cached OSM data
  roadsJson    String? @db.Text // Major roads as GeoJSON
  waterJson    String? @db.Text // Water bodies as GeoJSON
  barriersJson String? @db.Text // Fences, walls as GeoJSON (if available)

  @@unique([centerLatitude, centerLongitude, radiusMiles])
  @@index([expiresAt])
}

// ============================================================================
// Relay / Connect broker (Phase 2)
// Brokers contact between an anonymous finder and a lost-pet owner WITHOUT
// exposing either party's PII (phone/email/exact coords) until both opt in.
// Contract: .vaak/vision.md sec 4c/4d - docs/design/relay-connect-spec.md
// ============================================================================

enum RelayStatus {
  OPEN // thread created, awaiting owner
  OWNER_REPLIED // owner has responded at least once
  MUTUAL_OPTIN // both opted in -> direct contact unlocked
  REJECTED // owner marked "not my pet"
  REUNITED // confirmed reunion
}

/// One brokered connection between a FOUND report and a LOST case.
/// The opaque `token` is the only id exposed to clients (the card's matchId).
model MatchConnection {
  id    String @id @default(cuid())
  token String @unique @default(cuid())

  lostCaseId  String
  lostCase    Case   @relation("LostConnections", fields: [lostCaseId], references: [id], onDelete: Cascade)
  foundCaseId String
  foundCase   Case   @relation("FoundConnections", fields: [foundCaseId], references: [id], onDelete: Cascade)

  // Match snapshot at creation (from lib/matching.js - never recomputed client-side)
  matchScore  Int
  pTrueMatch  Float
  matchSource String // 'attribute' | 'visual' | 'microchip'

  status       RelayStatus @default(OPEN)
  finderOptIn  Boolean     @default(false)
  ownerOptIn   Boolean     @default(false)
  finderHandle String // anonymous, e.g. "Finder-7QX"
  finderTier   Int         @default(0) // 0 anon, 1 OTP+owner-accept, 2 mutual opt-in for raw PII

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  RelayMessage[]

  @@unique([lostCaseId, foundCaseId]) // idempotent open: one connection per pair
  @@index([token])
}

model RelayMessage {
  id           String          @id @default(cuid())
  connectionId String
  connection   MatchConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  senderRole   String // 'FINDER' | 'OWNER'
  body         String
  createdAt    DateTime        @default(now())

  @@index([connectionId])
}

// Adopted from the live DB (deployed from a side branch that never merged).
// Kept so schema sync on deploy stays additive and never threatens prod data.
model LocationDetectionLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Who
  userId    String? // null if not logged in
  sessionId String // Browser-generated session ID to group detections

  // Device
  userAgent String?
  ipAddress String?

  // Location
  latitude  Float
  longitude Float
  accuracy  Float? // GPS accuracy in meters

  // Reverse geocoded
  address String?
  city    String?

  // Outcome
  submitted  Boolean @default(false) // Did they actually submit a report?
  caseNumber String? // If submitted, the case number

  @@index([createdAt])
  @@index([userId])
  @@index([sessionId])
}

// Append-only journal of every medication mutation. Written in the SAME
// transaction as the change, with a full JSON snapshot, so dose history can
// always be reconstructed and every change is attributable. No foreign keys
// on purpose: nothing that happens to the primary rows can touch the journal.
model MedicationAuditLog {
  id           String   @id @default(cuid())
  petId        String
  medicationId String?
  doseId       String?
  action       String // MED_CREATED, MED_UPDATED, MED_DELETED, DOSE_LOGGED, DOSE_CHANGED, DOSE_VOIDED
  actorUserId  String?
  snapshot     String // JSON of the row after the change (and before, for updates)
  createdAt    DateTime @default(now())

  @@index([petId, createdAt])
  @@index([medicationId])
}

// ============================================================================
// Report-time action cascade (app/lib/cascade/*)
// When a lost report is created, a fire-and-forget cascade runs ~12 actions
// that generate flyers, social cards, AI copy, matches, a search plan, and
// neighbor alerts. Results are PERSISTED here so the success screen and the
// public case page can render "everything we did" on a plain reload with no
// live connection; SSE is only a live-update enhancement over these rows.
// ============================================================================

enum CascadeStatus {
  PENDING
  RUNNING
  PARTIAL // finished, but one or more steps failed/skipped
  COMPLETE
  FAILED
}

enum CascadeStepStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED // a dependency failed, or the step is not applicable
}

enum CaseAssetKind {
  QR
  FLYER_LETTER
  FLYER_HALF
  FLYER_POSTER
  SOCIAL_OG
  SOCIAL_SQUARE
  SOCIAL_STORY
  SEARCH_PLAN_PDF
}

enum FollowUpStatus {
  PENDING
  SUCCESS
  SKIPPED
  FAILED
}

// One row per lost case: the durable "we promised this" record + a
// denormalized summary rollup so a single query renders the dashboard.
model CaseActivation {
  id            String        @id @default(cuid())
  caseId        String        @unique
  caseNumber    String        @unique // SSE + read-API key (exists the instant the case does)
  case          Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  status        CascadeStatus @default(PENDING)
  correlationId String // threads to EventLog + the create-route UUID
  attemptCount  Int           @default(0)
  summary       Json          @default("{}") // denormalized counts/flags for one-query render
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  steps  CascadeStep[]
  assets CaseAsset[]

  @@index([status, updatedAt]) // resume/boot sweep for orphaned RUNNING/PENDING
  @@index([correlationId])
}

// One row per action per activation. Derived (non-file) output lives in
// `result`; binary files live in CaseAsset.
model CascadeStep {
  id           String            @id @default(cuid())
  activationId String
  activation   CaseActivation    @relation(fields: [activationId], references: [id], onDelete: Cascade)
  caseId       String
  caseNumber   String
  key          String // qr|flyers|social|ai_copy|reverse_match|shelters|search_plan|
  // neighbor_alert|rescue_force|share_kit|checklist|recovery_email|followups
  status       CascadeStepStatus @default(PENDING)
  count        Int? // N matches / shelters / neighbors (UI convenience)
  result       Json              @default("{}")
  error        String?
  startedAt    DateTime?
  finishedAt   DateTime?
  durationMs   Int?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([activationId, key]) // idempotency boundary - re-run upserts, never duplicates
  @@index([caseNumber])
}

// One row per downloadable binary artifact (PDF/PNG on the CDN).
model CaseAsset {
  id           String         @id @default(cuid())
  activationId String
  activation   CaseActivation @relation(fields: [activationId], references: [id], onDelete: Cascade)
  caseId       String
  caseNumber   String // denormalized: public read joins on this
  kind         CaseAssetKind
  status       String         @default("pending") // pending|ready|failed
  url          String? // Bunny CDN url (null until ready)
  thumbnailUrl String?
  mimeType     String? // application/pdf | image/png
  label        String         @default("")
  width        Int?
  height       Int?
  sizeBytes    Int?
  error        String?
  meta         Json           @default("{}")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([caseId, kind]) // idempotency - one asset per (case, kind); re-run overwrites
  @@index([caseNumber, status])
}

// Scheduled day-1/3/7 nudges. Drained by /api/cascade/sweep + an opportunistic
// piggyback (no cron infra); rows accumulate harmlessly until sent.
model CaseFollowUp {
  id        String         @id @default(cuid())
  caseId    String
  case      Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  day       Int // 1 | 3 | 7
  dueAt     DateTime
  channel   String // email | sms
  status    FollowUpStatus @default(PENDING)
  sentAt    DateTime?
  error     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([caseId, day]) // idempotency - one follow-up per (case, day)
  @@index([status, dueAt])
}

/// Durable rate-limit counters.
///
/// The in-memory limiter is per-process and resets whenever the process
/// does: every deploy, every restart, every scale event. That is how the
/// staging database collected 87,003 junk report rows through a limiter
/// that was, on paper, set to 10 per minute. Redis fixes it too, but only
/// once someone provisions Redis; this table needs nothing but the
/// database the app already has.
model RateLimitCounter {
  key          String    @id
  count        Int       @default(0)
  windowStart  DateTime  @default(now())
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([updatedAt])
}

/// The Rasuwa letter wizard's collective tally: how many families
/// pressed "done" on each finishing action (letters sent, entry
/// emailed, letter signed). Counts only, incremented anonymously;
/// nothing a family typed is ever stored (that promise is on the page).
model RasuwaTally {
  action    String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// The families' record of generated letters (founder instruction,
/// 2026-08-31: every missing person deserves a letter on record). One
/// row per finished wizard pass: whose letters, where the writer lives,
/// who they address, and the letter texts as generated. Saved when the
/// person moves from composing to delivering; the wizard says so
/// plainly. Write-only from the public API; read via /api/admin only.
model RasuwaLetterRecord {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  personName String
  where      String
  recipients String
  subject    String
  letters    Json

  @@index([personName, createdAt])
}
