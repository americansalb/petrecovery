// ============================================================================
// MISSION CONTROL - Real-time Tactical Coordination
// ============================================================================

model MissionControl {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Link to case
  caseId          String   @unique
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  // Operation mode
  mode            String   @default("INACTIVE") // INACTIVE, LIVE_SEARCH, CONTAINMENT, TRAP_OPS, STANDBY, RESOLVED, CLOSED

  // Activation
  activatedAt     DateTime?
  activatedById   String?
  activatorRole   String?  // OWNER, LEADER, ADMIN

  // Initial search config
  initialRadius   Float?   // Miles

  // Pause state
  pausedAt        DateTime?
  pausedById      String?
  pauseReason     String?

  // Cold case
  coldCaseAt      DateTime?
  resumedAt       DateTime?
  resumeReason    String?
  resumeConditions String?

  // Resolution
  resolvedAt      DateTime?
  resolutionType  String?  // FOUND_ALIVE, FOUND_DECEASED, CLOSED_OTHER
  foundLocation   String?  // JSON
  foundById       String?
  reunionPhotoUrl String?
  resolutionNotes String?

  // Containment mode
  containmentCenter     String?  // JSON: {lat, lng}
  containmentRadius     Float?
  containmentStartedAt  DateTime?
  perimeterPositions    String?  // JSON array
  activeSightingId      String?

  // Trap ops
  trapOpsStartedAt DateTime?

  // Owner state
  ownerStatus     String?  // AT_HOME, SEARCHING, AT_SHELTER, etc.
  ownerLocation   String?  // JSON
  ownerBroadcast  String?
  ownerLastUpdate DateTime?

  // Call mode
  ownerVoiceClipUrl     String?
  callModeActive        Boolean  @default(false)
  callModeLastTriggered DateTime?

  // Stats
  totalVolunteersJoined Int      @default(0)
  peakVolunteers        Int      @default(0)
  sightingsCount        Int      @default(0)
  lastSightingAt        DateTime?
  lastModeChange        DateTime?
  lastUpdatedBy         String?

  // Relations
  activeVolunteers MissionVolunteer[]
  zones            MissionZone[]
  sightings        MissionSighting[]
  resources        MissionResource[]
  traps            MissionTrap[]
  logs             MissionLog[]
  broadcasts       MissionBroadcast[]
  thankYous        MissionThankYou[]

  @@index([mode])
  @@index([activatedAt])
}

model MissionVolunteer {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  missionId       String
  mission         MissionControl @relation(fields: [missionId], references: [id], onDelete: Cascade)

  // Identity (supports anonymous)
  odId            String   // Device/session ID
  displayName     String
  isAnonymous     Boolean  @default(true)
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])

  // Status
  status          String   @default("ACTIVE") // AVAILABLE, ACTIVE, ON_BREAK, RESPONDING, PERIMETER, OFFLINE
  joinedAt        DateTime @default(now())

  // Location
  currentLocation     String?  // JSON
  lastLocationUpdate  DateTime?

  // Shift
  shiftStartedAt  DateTime?
  shiftEndedAt    DateTime?
  estimatedEndTime DateTime?

  // Zone assignment
  assignedZoneId  String?

  // Resources
  resources       String?  // JSON array: ['CAR', 'TRAP', 'FLYERS']

  // Perimeter mode
  perimeterPosition String?  // NORTH, SOUTH, etc.
  perimeterTarget   String?  // JSON: {lat, lng}
  perimeterArrivedAt DateTime?

  // Resources relation
  missionResources  MissionResource[]

  @@unique([missionId, odId])
  @@index([missionId])
  @@index([status])
  @@index([userId])
}

model MissionZone {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  missionId       String
  mission         MissionControl @relation(fields: [missionId], references: [id], onDelete: Cascade)

  // Grid reference
  gridRef         String   // A1, B2, etc.

  // Bounds
  northLat        Float
  southLat        Float
  eastLng         Float
  westLng         Float

  // Status
  status          String   @default("UNSEARCHED") // UNSEARCHED, IN_PROGRESS, SEARCHED, STALE, HIGH_PROBABILITY, SIGHTING
  priority        String   @default("MEDIUM")     // LOW, MEDIUM, HIGH

  // Probability
  probability     Float    @default(0.5)

  // Assignment
  assignedToId    String?
  assignedAt      DateTime?

  // Search history
  lastSearchedAt  DateTime?
  lastSearchedById String?
  searchCount     Int      @default(0)

  // Terrain
  terrainType     String?  // URBAN, WOODED, WATER, OPEN
  hasHidingSpots  Boolean  @default(false)

  @@unique([missionId, gridRef])
  @@index([missionId])
  @@index([status])
  @@index([probability])
}

model MissionSighting {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  missionId       String
  mission         MissionControl @relation(fields: [missionId], references: [id], onDelete: Cascade)

  // Reporter
  reporterId      String   // odId or odId
  reporterName    String?

  // Location
  latitude        Float
  longitude       Float

  // Details
  confidence      String   // CONFIRMED, HIGH, MEDIUM, LOW
  priority        String   // Maps from confidence
  photoUrl        String?
  notes           String?
  petDirection    String?  // Direction pet was heading

  // Verification
  verified        Boolean  @default(false)
  verifiedById    String?
  verifiedAt      DateTime?
  status          String   @default("PENDING") // PENDING, VERIFIED, DISMISSED

  @@index([missionId])
  @@index([createdAt])
  @@index([verified])
  @@index([priority])
}

model MissionResource {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  missionId       String
  mission         MissionControl @relation(fields: [missionId], references: [id], onDelete: Cascade)

  // Resource type
  type            String   // CAR, TRAP, FLYERS, TREATS, CARRIER, FLASHLIGHT

  // Owner
  volunteerId     String
  volunteer       MissionVolunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  // Status
  location        String?  // JSON
  available       Boolean  @default(true)

  // If requested
  requestedById   String?
  requestedAt     DateTime?
  requestLocation String?  // JSON

  @@unique([missionId, type, volunteerId])
  @@index([missionId])
  @@index([type])
  @@index([available])
}

model MissionTrap {
  id              String   @id @default(cuid())
