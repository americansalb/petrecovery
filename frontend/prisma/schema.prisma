  createdAt   DateTime @default(now())

  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  // Message
  message     String
  photoUrl    String?  // Reunion photo

  // Recipient (null = all volunteers)
  recipientId String?

  @@index([caseId])
  @@index([recipientId])
}

model CasePriorityMode {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  // Timing
  startedAt   DateTime
  expiresAt   DateTime
  endedAt     DateTime?
  endReason   String?

  // Metadata
  triggeredBy String   // USER_ID or 'AUTO' or 'SYSTEM'
  reason      String?

  // Status
  isActive    Boolean  @default(true)

  @@index([caseId])
  @@index([isActive])
}

model SurgeEvent {
  id                  String   @id @default(cuid())
  createdAt           DateTime @default(now())

  caseId              String
  type                String   // PRIORITY_ACTIVATED, COVERAGE_GAP, RE_SURGE

  // Stats
  squadsNotified      Int      @default(0)
  volunteersNotified  Int      @default(0)

  @@index([caseId])
}

model SquadJoinRequest {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rescueSquadId   String
  rescueSquad     RescueSquad @relation(fields: [rescueSquadId], references: [id], onDelete: Cascade)
  divisionId      String?

  // Request
  message         String?

  // Review
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?

  @@unique([userId, rescueSquadId])
  @@index([rescueSquadId])
  @@index([status])
}
