model TrapCheck {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())

  trapId          String
  trap            MissionTrap @relation(fields: [trapId], references: [id], onDelete: Cascade)

  checkedById     String
  status          String   // OK, NEEDS_REBAIT, TRIGGERED, ISSUE
  notes           String?
