// ============================================================================
// ACTIONS V1 - Points & Verification System
// See docs/Actions_Guide.md for full specification
// ============================================================================

/// Verification methods for verified actions
enum VerificationMethod {
  GPS // Location-tracked (search, flyer posting, knocking)
  PLATFORM_EMAIL // Emails sent via Resend
  PHOTO // Photo proof attached
  CALL_DETECT // Future: technical call detection
}

/// Valid action types for verified actions
/// IMPORTANT: Use ONLY these values. Typos corrupt analytics.
enum ActionType {
  search_area
  check_hiding
  contact_shelters
  contact_vets
  contact_animal_control
  post_flyers
  knock_doors
  litter_outside
  scent_items
  food_station
  camera_setup
  humane_trap
  garage_open
}

/// Verified action record - creates when action is GPS/EMAIL/PHOTO verified
model VerifiedAction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Core references
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId String @map("caseId")

  // Action details
  actionType         ActionType
  verificationMethod VerificationMethod
  hoursAfterLost     Float? // Hours from case.lostAt to action time (for analytics)

  // Points
  basePoints  Int
  bonusPoints Int     @default(0)
  totalPoints Int // basePoints + bonusPoints
  multipliers String? // JSON: [{type, value, label}]

  // Metadata (varies by action type)
  metadata String? // JSON: {distanceMiles, shelterName, flyerLocation, etc.}

  // Location (for GPS-verified actions)
  latitude  Float?
  longitude Float?

  // Photo (for PHOTO-verified actions)
  photoUrl String?

  // Email tracking (for PLATFORM_EMAIL actions)
  emailId        String? // Resend email ID
  emailOpened    Boolean   @default(false)
  emailOpenedAt  DateTime?
  emailReplied   Boolean   @default(false)
  emailRepliedAt DateTime?

  @@index([userId])
  @@index([missionId])
  @@index([actionType])
  @@index([createdAt])
  @@index([userId, missionId])
}

/// Daily points log - SOURCE OF TRUTH for daily points
/// One row per user per UTC date
model DailyPointsLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // UTC date (YYYY-MM-DD format stored as string for easy querying)
  date String // e.g., "2025-12-07"

  // Points breakdown
  verifiedPoints     Int @default(0) // Unlimited, from VerifiedAction
  selfReportedPoints Int @default(0) // Capped at 100/day

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

/// Shelter/Vet/Animal Control contact status
enum ShelterContactStatus {
  NOT_CONTACTED
  CONTACTED
  AWAITING_RESPONSE
  NO_MATCH
  POSSIBLE_MATCH
  MATCH_FOUND
}

/// Contact method for shelter attempts
enum ContactMethodType {
  CALL
  EMAIL
  IN_PERSON
}

/// Call outcome options
enum CallOutcome {
  NO_ANSWER
  LEFT_VOICEMAIL
  SPOKE_WITH_STAFF
  WRONG_NUMBER
  BUSY
}

/// Staff response options
enum StaffResponse {
  NO_MATCHING_ANIMALS
  POSSIBLE_MATCH
  CONFIRMED_MATCH
  WILL_CHECK_AND_CALL_BACK
  OTHER
}

/// Shelter contact record - tracks contact with shelters/vets/animal control
model ShelterContact {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  missionId String @map("caseId")

  // External place reference (Google Places API)
  placeId        String // Google Places ID
  shelterName    String
  shelterAddress String
  shelterPhone   String?
  shelterEmail   String?
  shelterType    String  @default("SHELTER") // SHELTER, VET, ANIMAL_CONTROL

  // Location
  latitude  Float
  longitude Float

  // Status
  status            ShelterContactStatus @default(NOT_CONTACTED)
  lastContactedAt   DateTime?
  lastContactMethod ContactMethodType?
  notes             String?

  // Contact attempts
  attempts ShelterContactAttempt[]

  @@unique([missionId, placeId])
  @@index([missionId])
  @@index([status])
}

/// Individual contact attempt with a shelter
model ShelterContactAttempt {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  shelterContactId String
  shelterContact   ShelterContact @relation(fields: [shelterContactId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Contact method
  method ContactMethodType

  // Call-specific fields
  callOutcome   CallOutcome?
  staffResponse StaffResponse?

  // Email-specific fields (for platform emails via Resend)
  emailId        String? // Resend email ID
  emailOpened    Boolean   @default(false)
  emailOpenedAt  DateTime?
  emailReplied   Boolean   @default(false)
  emailRepliedAt DateTime?

  // Notes
  notes String?

  // Points tracking
  pointsEarned     Int     @default(0)
  isVerified       Boolean @default(false) // True for platform emails
  verifiedActionId String? @unique // Link to VerifiedAction if verified

  @@index([shelterContactId])
  @@index([userId])
  @@index([createdAt])
}

/// GPS-verified flyer posting
model FlyerPosting {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  missionId String @map("caseId")
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Location (GPS-verified)
  latitude  Float
  longitude Float

  // Optional photo
  photoUrl String?

  // Notes
  notes String?

  // Points tracking
  pointsEarned     Int     @default(0)
  isVerified       Boolean @default(true) // GPS-verified by default
  verifiedActionId String? @unique // Link to VerifiedAction

  @@index([missionId])
  @@index([userId])
  @@index([createdAt])
}

// ============================================================================
// PHASE 5: MASCOT TIPS (SCOUT INTELLIGENCE)
// ============================================================================

// TipType - Types of Scout tips
// Per Actions_Guide.md specification
enum TipType {
  TIME // Time-based tips (dawn, dusk)
  WEATHER // Weather-related tips
  PROGRESS // Milestone/progress tips
  LOCATION // Unsearched area tips
  COLD_SPOT // Flyer coverage tips
  STRATEGY // General search strategy tips
  ENCOURAGE // Morale boost tips
  SIGHTING // New sighting alerts
}

// MascotTip - Scout's contextual tips and encouragement
// Tips appear as banners in the UI and as messages in mission chat.
// Generated based on time, weather, progress, and location context.
model MascotTip {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  missionId String @map("caseId")
  case      Case   @relation(fields: [missionId], references: [id], onDelete: Cascade)

  // Tip content
  tipType  TipType
  message  String
  title    String? // Optional headline (e.g., "Dusk Alert!")
  priority Int     @default(50) // 0-100, higher = more important

  // Action button (optional)
  actionLabel String? // e.g., "Start Search"
  actionType  String? // e.g., "navigate:search", "navigate:flyers"

  // Tip lifecycle
  expiresAt      DateTime?
  dismissedBy    String[]  @default([]) // User IDs who dismissed this tip
  postedToChat   Boolean   @default(false)
  postedToChatAt DateTime?

  // Context metadata (for debugging/analytics)
  context Json? // e.g., { hour: 17, weather: "rain", sheltersContacted: 5 }

  @@index([missionId])
  @@index([tipType])
  @@index([createdAt])
}

// ============================================================================
// PHASE 6: ALGORITHM TRAINING - CASE OUTCOMES
// ============================================================================

// OutcomeType - How the case was resolved
// Per Actions_Guide.md Phase 6 specification
enum OutcomeType {
  REUNITED // Pet found and returned to owner
  NOT_FOUND // Search ended without finding pet
  DECEASED // Pet found deceased
  CLOSED_OTHER // Closed for other reasons
}

// FoundMethod - How the pet was found (for REUNITED cases)
// This data helps train the algorithm to recommend effective actions
enum FoundMethod {
  CAME_HOME // Pet returned on their own
  SHELTER_INTAKE // Found at a shelter
  NEIGHBOR_FOUND // Neighbor/community member found them
  SIGHTING_LED_TO // A reported sighting led to recovery
  TRAP_CAUGHT // Caught in a humane trap
  FLYER_RESPONSE // Someone saw a flyer and called
  SOCIAL_MEDIA // Found through social media post
  OTHER // Other method
}

// CaseOutcome - Detailed case resolution data for ML training
// This model captures everything needed to train the recommendation
// algorithm: what actions were taken, how long it took, and what worked.
// OWNERSHIP & LIFECYCLE:
// - Created when the owner or moderator closes a case
// - Only admins/moderators can edit after creation
// - ML training can tolerate some missing outcomes initially
model CaseOutcome {
  id        String @id @default(cuid())
  missionId String @unique @map("caseId")
  case      Case   @relation(fields: [missionId], references: [id], onDelete: Cascade)

  // Resolution details
  outcome            OutcomeType
  timeToReunionHours Float? // Hours from case creation to resolution
  foundMethod        FoundMethod?
  foundMethodDetails String? // Free-form details about how pet was found

  // Context snapshot for ML (denormalized from Case at time of closure)
  petType           String // 'CAT' | 'DOG'
  petBehavior       String? // 'INDOOR' | 'OUTDOOR' | 'SKITTISH' | 'FRIENDLY'
  petSize           String? // 'SMALL' | 'MEDIUM' | 'LARGE'
  locationType      String? // 'URBAN' | 'SUBURBAN' | 'RURAL'
  weatherConditions String? // Weather at time of reunion (JSON or simple string)

  // Actions summary (denormalized for fast analytics queries)
  verifiedActionsCount   Int  @default(0)
  verifiedActionsSummary Json @default("[]") // Array of { actionType, count, avgHoursAfterLost }

  // Additional metrics
  totalSearchHours       Float? // Total hours of GPS-tracked searches
  totalFlyersPosted      Int    @default(0)
  totalSheltersContacted Int    @default(0)
  sightingsCount         Int    @default(0)
  teamMembersCount       Int    @default(0)

  // User feedback
  ownerFeedback  String? // Optional owner feedback about what helped
  helpfulActions String[] @default([]) // Actions owner marked as helpful

  createdAt DateTime @default(now())
  createdBy String? // User ID who recorded the outcome

  @@index([outcome])
  @@index([petType])
  @@index([foundMethod])
  @@index([createdAt])
}

// ============================================================================
// OWNER-FINDER MESSAGING SYSTEM
// ============================================================================
// Secure communication channel between pet owners and finders
// Created when a match is found between lost and found pet reports

model Conversation {
  id String @id @default(cuid())

  // The two cases being connected
  lostCaseId  String // The LOST pet case (owner's case)
  foundCaseId String // The FOUND pet case (finder's case)

  // Participants
  ownerId  String // User who lost their pet
  finderId String // User who found a pet

  // Match context
  matchScore   Int // The algorithm match score (0-100)
  matchDetails String @default("{}") // JSON: score breakdown

  // Conversation status
  status ConversationStatus @default(ACTIVE)

  // Privacy settings
  ownerRevealed  Boolean @default(false) // Owner chose to share contact info
  finderRevealed Boolean @default(false) // Finder chose to share contact info

  // Verification
  ownerVerified    Boolean @default(false) // Owner provided proof of ownership
  reunionConfirmed Boolean @default(false) // Both parties confirmed reunion

  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime @default(now())

  // Soft close (conversation can be reopened)
  closedAt    DateTime?
  closedBy    String? // User ID who closed
  closeReason String? // "reunited", "not_my_pet", "no_response", "spam"

  // Relations
  messages DirectMessage[]

  @@unique([lostCaseId, foundCaseId]) // Only one conversation per match
  @@index([ownerId])
  @@index([finderId])
  @@index([status])
  @@index([lastMessageAt])
  @@index([lostCaseId])
  @@index([foundCaseId])
}

enum ConversationStatus {
  ACTIVE // Conversation is open
  PENDING_OWNER // Waiting for owner to respond
  PENDING_FINDER // Waiting for finder to respond
  REUNION_PENDING // Arranging meetup
  REUNITED // Pet successfully returned
  CLOSED // Conversation closed (not a match, etc.)
}

model DirectMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Sender
  senderId   String // User ID of sender
  senderRole MessageSenderRole // OWNER or FINDER

  // Content
  content     String
  messageType DirectMessageType @default(TEXT)

  // Attachments
  photoUrls    String  @default("[]") // JSON array of image URLs
  locationData String? // JSON: { lat, lng, address } for meetup coordination

  // Read status
  readAt DateTime?

  // Moderation
  isHidden     Boolean @default(false) // Hidden by moderator
  hiddenReason String?

  // Timestamps
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

enum MessageSenderRole {
  OWNER // Pet owner
  FINDER // Person who found the pet
  SYSTEM // System-generated message
}

enum DirectMessageType {
  TEXT // Regular text message
  PHOTO // Photo message
  LOCATION // Location share (for meetup)
  CONTACT_SHARED // User shared their contact info
  VERIFICATION // Ownership verification (photos, docs)
  REUNION_PROPOSED // Proposed meetup time/place
  REUNION_CONFIRMED // Confirmed reunion happened
  SYSTEM // System notification
}

// ============================================================================
// RESCUE HUB - COMMUNITY FORUM
// ============================================================================
// A community space for pet rescuers to connect, learn, and coordinate

model ForumCategory {
  id           String  @id @default(cuid())
  name         String  @unique
  slug         String  @unique
  description  String
  icon         String? // Emoji or icon name
  color        String  @default("#6366f1") // Brand color for category
  displayOrder Int     @default(0)

  // Nesting (for sub-categories)
  parentId String?
  parent   ForumCategory?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children ForumCategory[] @relation("CategoryChildren")

  // Permissions
  requiredTrustLevel Int     @default(1) // Minimum trust level to post
  isModOnly          Boolean @default(false) // Only mods can post
  isReadOnly         Boolean @default(false) // Archived, no new posts

  // Metadata
  threadCount    Int       @default(0)
  postCount      Int       @default(0)
  lastActivityAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  threads ForumThread[]

  @@index([slug])
  @@index([displayOrder])
  @@index([parentId])
}

model ForumThread {
  id    String @id @default(cuid())
  title String
  slug  String @unique

  // Category
  categoryId String
  category   ForumCategory @relation(fields: [categoryId], references: [id])

  // Author. The categories and search routes select this relation; it was
  // never declared, so both threw. Account deletion anonymizes User rows
  // rather than removing them, so the foreign key holds.
  authorId String
  author   User   @relation("ForumThreadAuthor", fields: [authorId], references: [id])

  // Content (first post is stored here for efficiency)
  content     String  @db.Text
  contentHtml String? @db.Text // Pre-rendered HTML

  // Embedded content
  embeddedPetId     String? // Link to a pet case
  embeddedShelterId String? // Link to a shelter

  // Location tagging
  locationTag String? // City, State or region
  latitude    Float?
  longitude   Float?

  // Status flags. isHidden is a reversible moderator action; isDeleted is
  // removal. Every hub route filters on isDeleted - it was missing here,
  // which made every one of those queries throw and rendered the whole
  // forum empty.
  isPinned     Boolean @default(false)
  isLocked     Boolean @default(false)
  isSolved     Boolean @default(false)
  isHidden     Boolean @default(false)
  isDeleted    Boolean @default(false)
  hiddenReason String?
  hiddenBy     String?

  // Urgency (for time-sensitive posts)
  urgencyLevel ThreadUrgency @default(NORMAL)

  // Engagement
  viewCount    Int @default(0)
  replyCount   Int @default(0)
  helpfulCount Int @default(0) // Sum of helpful reactions

  // Timestamps
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastActivityAt DateTime  @default(now())
  bumpedAt       DateTime? // For mod-bumped threads

  // Relations
  posts     ForumPost[]
  bookmarks ForumBookmark[]

  @@index([categoryId])
  @@index([authorId])
  @@index([slug])
  @@index([isPinned, lastActivityAt])
  @@index([urgencyLevel])
  @@index([locationTag])
  @@index([createdAt])
}

enum ThreadUrgency {
  NORMAL
  URGENT // Needs attention soon
  CRITICAL // Emergency (disaster, immediate danger)
}

model ForumPost {
  id String @id @default(cuid())

  // Thread
  threadId String
  thread   ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  // Author (see ForumThread.author for why this relation exists)
  authorId String
  author   User   @relation("ForumPostAuthor", fields: [authorId], references: [id])

  // Reply hierarchy (optional nesting)
  replyToId String?
  replyTo   ForumPost?  @relation("PostReplies", fields: [replyToId], references: [id])
  replies   ForumPost[] @relation("PostReplies")

  // Content
  content     String  @db.Text
  contentHtml String? @db.Text // Pre-rendered HTML

  // Embedded content
  embeddedPetId     String?
  embeddedShelterId String?
  imageUrls         String  @default("[]") // JSON array

  // Status. isDeleted mirrors ForumThread: the mod tools and search
  // filter on it, and it was missing from the schema.
  isHidden     Boolean @default(false)
  isDeleted    Boolean @default(false)
  hiddenReason String?
  hiddenBy     String?
  isSolution   Boolean @default(false) // Marked as answer

  // Engagement
  helpfulCount Int @default(0)
  heartCount   Int @default(0)
  thanksCount  Int @default(0)
  reportCount  Int @default(0)

  // Timestamps
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  // Relations
  reactions ForumReaction[]
  reports   ForumReport[]

  @@index([threadId])
  @@index([authorId])
  @@index([replyToId])
  @@index([createdAt])
}

model ForumReaction {
  id String @id @default(cuid())

  postId String
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  type   ReactionType

  createdAt DateTime @default(now())

  @@unique([postId, userId, type])
  @@index([postId])
  @@index([userId])
}

enum ReactionType {
  HELPFUL
  HEART
  THANKS
}

model ForumReport {
  id String @id @default(cuid())

  postId String
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  reporterId String
  reason     ReportReason
  details    String?

  // Resolution
  status     ReportStatus @default(PENDING)
  resolvedBy String?
  resolvedAt DateTime?
  resolution String? // Mod notes on resolution

  createdAt DateTime @default(now())

  @@index([postId])
  @@index([reporterId])
  @@index([status])
}

enum ReportReason {
  SPAM
  HARASSMENT
  MISINFORMATION
  OFF_TOPIC
  INAPPROPRIATE
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  ACTION_TAKEN
  DISMISSED
}

model ForumBookmark {
  id String @id @default(cuid())

  threadId String
  thread   ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  userId String

  createdAt DateTime @default(now())

  @@unique([threadId, userId])
  @@index([userId])
}

// User's forum-specific profile
model ForumProfile {
  userId String @id

  // Display
  bio      String?
  location String?

  // Trust system
  trustLevel Int @default(0) // 0-4
  reputation Int @default(0)

  // Badges (JSON array of badge IDs)
  badges String @default("[]")

  // Stats
  postsCount      Int @default(0)
  threadsCount    Int @default(0)
  helpfulReceived Int @default(0)
  solutionsCount  Int @default(0)

  // Flags
  isVerifiedShelter Boolean   @default(false)
  isVerifiedRescue  Boolean   @default(false)
  isModerator       Boolean   @default(false)
  isBanned          Boolean   @default(false)
  bannedAt          DateTime?
  bannedReason      String?
