// PetRecovery.org Database Schema - Rescue Squad Model
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE USER SYSTEM
// ============================================================================

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  emailVerified   DateTime?
  phone           String?
  phoneVerified   Boolean  @default(false)
  firstName       String
  lastName        String?
  passwordHash    String?  // Null for quick signup
  role            UserRole @default(USER)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastActive      DateTime @default(now())

  // Rescue Gamification Stats
  rescueLevel     RescueLevel @default(PET_OWNER)
  squadsJoinedCount Int      @default(0)
  areasMarkedCount Int       @default(0)
  totalAcreageSearched Float @default(0)
  successfulReunions Int     @default(0)
  honorsReceived  Int         @default(0)
  lastLevelUpAt   DateTime?

  // Legal Tracking (Phase 0)
  tosAcceptedAt       DateTime?
  tosVersionAccepted  String?
  waiverAcceptedAt    DateTime?
  waiverVersionAccepted String?

  // Password Reset (Phase 0.1)
  resetToken          String?   @unique  // Stored as bcrypt hash
  resetTokenExpiry    DateTime?

  // Email Verification
  emailVerifyToken    String?   @unique
  emailVerifyExpiry   DateTime?

  // Relations
  profile         UserProfile?
  patrolProfile   PatrolProfile?
  pets            Pet[]
  cases           Case[]        @relation("CaseReporter")
  foundCases      Case[]        @relation("CaseFoundBy")
  alerts          Alert[]
  caseSightings   CaseSighting[]
  caseUpdates     CaseUpdate[]

  // Rescue Squad Relations
  rescueSquadMemberships RescueSquadMember[]
  caseParticipations     CaseParticipant[]
  searchAreas            SearchArea[]
  petSpottings           PetSpotting[]
  squadMessages          SquadMessage[]
  receivedHonors         SquadHonor[] @relation("HonoredUser")
  givenHonors            SquadHonor[] @relation("HonoringUser")
  squadActivities        SquadActivity[]
  assignedTasks          SquadTask[] @relation("TaskAssignee")
  createdTasks           SquadTask[] @relation("TaskCreator")
  completedTasks         SquadTask[] @relation("TaskCompleter")
  squadPosts             SquadPost[]
  squadPostComments      SquadPostComment[]
  squadPostVotes         SquadPostVote[]
  squadCommentVotes      SquadCommentVote[]
  taskParticipations     TaskParticipant[]

  // Division Relations
  divisionRequests       DivisionRequest[]
  reviewedDivisionRequests DivisionRequest[] @relation("ReviewedDivisionRequests")

  // Community Relations (LEGACY - keeping for backwards compatibility)
  communityRequests CommunityRequest[]
  reviewedRequests CommunityRequest[] @relation("ReviewedRequests")
  communityMemberships CommunityMember[]
  createdCommunities Community[] @relation("CommunityCreator")
  approvedCommunities Community[] @relation("CommunityApprover")
  communityPosts  CommunityPost[]

  // Lost Pet Case Relations (Phase 13-14)
  createdCases    LostPetCase[]
  caseNotes       LostPetCaseNote[]

  // OAuth Accounts (Phase 7)
  accounts        Account[]
  emailPreferences EmailPreference?
  smsPreferences   SmsPreference?
  pushSubscriptions PushSubscription[]
  notifications    Notification[]
  phoneVerifications PhoneVerification[]
  lastLoginAt     DateTime?
  profileImage    String?

  // Cases where this user is the primary coordinator (Phase 22-24)
  coordinatedCases LostPetCase[]  @relation("CaseCoordinator")

  // Volunteer Coordination (Phases 1-10)
  searchedGridCells GridCell[]
  squadJoinRequests SquadJoinRequest[]

  // Mission Control
  missionVolunteers MissionVolunteer[]

  // Actions v1: Points & Verification
  verifiedActions      VerifiedAction[]
  dailyPointsLogs      DailyPointsLog[]
  shelterContactAttempts ShelterContactAttempt[]
  flyerPostings        FlyerPosting[]

  // Engagement stats
  currentStreak     Int      @default(0)
  longestStreak     Int      @default(0)
  lastActiveDate    DateTime?
  totalSearchDays   Int      @default(0)
  responseRate      Float?   // Percentage of alerts responded to
  averageResponseTime Float? // Minutes
  deviceId          String?  // For guest volunteers

  @@index([email])
  @@index([rescueLevel])
}

enum UserRole {
  USER
  PATROL
  MODERATOR
  ADMIN
}

enum RescueLevel {
  PET_OWNER    // Level 0: Submitted a lost pet request
  SCOUT        // Level 1: Joined a rescue squad
  SENTRY       // Level 2: Participated in first case
  SHEPHERD     // Level 3: Marked 5+ areas, 15+ acres total
  PATHFINDER   // Level 4: 1+ successful reunion
  PACK_GUARDIAN // Level 5: 5+ successful reunions
  PACK_LEGEND  // Level 6: 50+ successful reunions
}

model UserProfile {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Location
  latitude        Float?
  longitude       Float?
  address         String?
  city            String?
  state           String?
  zip             String?
  country         String   @default("US")

  // Preferences
  timezone        String   @default("America/Chicago")
  notificationsEnabled Boolean @default(true)

  updatedAt       DateTime @updatedAt

  @@index([latitude, longitude])
}

// RECOVERY PATROL SYSTEM (keeping for backwards compatibility)
model PatrolProfile {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Status
  isActive        Boolean  @default(true)
  isPaused        Boolean  @default(false)

  // Coverage
  radiusMiles     Int      @default(5)
  maxActiveSearches Int    @default(3)

  // Availability (stored as JSON strings for SQLite compatibility)
  availability    String   @default("[]") // JSON: ["weekday_morning", "weekday_evening", "weekend_morning", "weekend_evening"]
  transportation  String   @default("[]") // JSON: ["foot", "bike", "car"]

  // Pet preferences
  searchesDogs    Boolean  @default(true)
  searchesCats    Boolean  @default(true)
  searchesBirds   Boolean  @default(false)
  searchesOther   Boolean  @default(false)

  // Notification preferences
  alertMethod     AlertMethod @default(EMAIL)
  quietHoursStart Int?     // Hour (0-23)
  quietHoursEnd   Int?     // Hour (0-23)
  instantAlerts   Boolean  @default(true)

  // Stats
  joinedAt        DateTime @default(now())
  searchCount     Int      @default(0)
  recoveryCount   Int      @default(0)

  // Gamification
  points          Int      @default(0)
  level           PatrolLevel @default(ROOKIE)

  updatedAt       DateTime @updatedAt
}

enum AlertMethod {
  EMAIL
  SMS
  PUSH
  ALL
}

enum PatrolLevel {
  ROOKIE      // 0 recoveries
  SCOUT       // 1 recovery
  TRACKER     // 5 recoveries
  EXPERT      // 10 recoveries
  LEGEND      // 25+ recoveries
}

// ============================================================================
// LEGAL DOCUMENT SYSTEM (Phase 0)
// ============================================================================

model LegalDocument {
  id              String   @id @default(cuid())

  // Document Identity
  slug            String   @unique  // "terms-of-service", "liability-waiver", "privacy-policy"
  type            LegalDocumentType
  version         String             // e.g., "1.0.0"

  // Content
  title           String             // "Terms of Service"
  content         String             // Full markdown/HTML content
  summary         String?            // Short summary for UI

  // Status
  isActive        Boolean  @default(true)
  publishedAt     DateTime @default(now())

  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([type, isActive])
}

enum LegalDocumentType {
  TERMS_OF_SERVICE
  LIABILITY_WAIVER
  PRIVACY_POLICY
}

enum LostPetCaseStatus {
  OPEN
  ACTIVE_SEARCH
  RESOLVED
  CLOSED_OTHER
}

// ============================================================================
// EVENT LOGGING SYSTEM (Phase 0)
// ============================================================================

model EventLog {
  id              String   @id @default(cuid())

  // Event Identity
  event_type      String   // e.g., "squad.created", "user.login_failed"
  timestamp       DateTime @default(now())
  correlation_id  String   // UUID to trace related events

  // Actor Context
  actor_user_id   String?
  actor_role      String?  // "OWNER", "VOLUNTEER", "ADMIN", etc.

  // Resource Context
  resource_type   String   // "user", "squad", "case", "sighting", etc.
  resource_id     String?

  // Action & Result
  action          String   // "create", "update", "delete", "read", "transition"
  result          String   // "success" or "failure"

  // Error Details (for failures)
  error_code      String?
  error_message   String?  // Safe summary, no secrets

  // Additional Context
  metadata        String   @default("{}") // JSON string

  @@index([event_type])
  @@index([timestamp])
  @@index([result])
  @@index([correlation_id])
  @@index([event_type, error_code]) // For error aggregation
  @@index([actor_user_id])
}

// ============================================================================
// PET SYSTEM
// ============================================================================

model Pet {
  id              String   @id @default(cuid())
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Basic info
  name            String
  species         PetSpecies
  breed           String?
  age             Int?
  sex             PetSex?
  isNeutered      Boolean  @default(false)

  // Physical description
  color           String
  size            PetSize
  weight          Float?
  distinctiveMarks String?

  // Identification
  microchipId     String?
  collarInfo      String?

  // Behavior
  personality     String   @default("[]") // JSON: ["friendly", "shy", etc]
  medicalConditions String?

  // Media
  photos          String   @default("[]") // JSON: ["url1", "url2", etc]
  primaryPhotoUrl String

  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Soft Delete
  isDeleted       Boolean  @default(false)
  deletedAt       DateTime?

  // Relations
  cases           Case[]

  @@index([ownerId])
  @@index([isDeleted])
}

enum PetSpecies {
  DOG
  CAT
  BIRD
  RABBIT
  OTHER
}

enum PetSex {
  MALE
  FEMALE
  UNKNOWN
}

enum PetSize {
  TINY     // < 10 lbs
  SMALL    // 10-25 lbs
  MEDIUM   // 25-60 lbs
  LARGE    // 60-90 lbs
  GIANT    // > 90 lbs
}

// ============================================================================
// CASE SYSTEM (was LostReport)
// ============================================================================

model Case {
  id              String   @id @default(cuid())
  caseNumber      String   @unique // "CHI-2024-001847"

  // Pet Information (denormalized for performance)
  petId           String?  // Optional reference to Pet
  pet             Pet?     @relation(fields: [petId], references: [id])
  petName         String
  petSpecies      PetSpecies
  petBreed        String?
  petColor        String
  petSize         PetSize
  petPhotoUrl     String
  petDescription  String   // Full description

  // Reporter/Owner
  reporterId      String
  reporter        User     @relation("CaseReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  ownerName       String
  ownerPhone      String
  ownerEmail      String

  // Case Details
  reportType      ReportType @default(LOST)
  status          CaseStatus @default(ACTIVE)
  priority        CasePriority @default(NORMAL)

  // Location
  lastSeenAt      DateTime
  lastSeenLatitude Float
  lastSeenLongitude Float
  lastSeenAddress String
  searchRadius    Float    @default(5) // Miles

  // Incident
  escapeScenario  String
  escapeDetails   String?

  // Meta Ads Integration
  metaAdCampaignId String?
  metaAdBudget    Float?
  metaAdStatus    String?  // "running", "paused", "completed"

  // Reward
  hasReward       Boolean  @default(false)
  rewardAmount    Float?

  // Engagement Metrics
  viewCount       Int      @default(0)
  shareCount      Int      @default(0)
  activeSearchers Int      @default(0)

  // Resolution
  resolvedAt      DateTime?
  resolution      CaseResolution?
  resolutionNotes String?
  foundById       String?
  foundBy         User?    @relation("CaseFoundBy", fields: [foundById], references: [id], onDelete: SetNull)

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiresAt       DateTime?

  // Relations
  assignments     CaseAssignment[]
  sightings       CaseSighting[]
  updates         CaseUpdate[]
  alerts          Alert[]

  // Volunteer Coordination (Phases 1-10)
  ownerThankYous    OwnerThankYou[]
  priorityModes     CasePriorityMode[]
  priorityLevel     String?  // CRITICAL, HIGH, ELEVATED, NORMAL, LOW

  // Mission Control
  missionControl    MissionControl?

  // Phase 5: Scout Tips
  mascotTips        MascotTip[]

  // Phase 6: Case Outcome (for ML training)
  caseOutcome       CaseOutcome?

  @@index([status])
  @@index([caseNumber])
  @@index([lastSeenLatitude, lastSeenLongitude])
  @@index([createdAt])
}

enum ReportType {
  LOST    // Owner reporting their lost pet
  FOUND   // Someone reporting they found a pet
}

enum CaseStatus {
  ACTIVE           // Just reported, awaiting rescue squad acceptance
  IN_PROGRESS      // One or more rescue squads actively searching
  SIGHTING_REPORTED // Pet has been sighted
  REUNITED         // Pet found and returned to owner
  CLOSED_OTHER     // Closed for other reasons
}

enum CasePriority {
  LOW              // Adult healthy pet, good weather
  NORMAL           // Standard case
  HIGH             // Medical needs, extreme weather, dangerous area
  URGENT           // Life-threatening situation
}

enum CaseResolution {
  REUNITED         // Found by organized search
  FOUND_BY_OWNER   // Owner found pet themselves
  FOUND_AT_SHELTER // Brought to shelter
  CAME_HOME        // Pet returned on its own
  DECEASED         // Pet found deceased
  SEARCH_CEASED    // Owner stopped searching
}

// ALERT SYSTEM
model Alert {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Delivery
  method          AlertMethod
  sentAt          DateTime @default(now())
  deliveredAt     DateTime?
  openedAt        DateTime?

  // Response
  respondedAt     DateTime?
  response        AlertResponse?
  responseNote    String?

  @@index([caseId])
  @@index([userId])
  @@index([sentAt])
}

enum AlertResponse {
  WILL_SEARCH
  CANT_NOW
  WATCHING
  NOT_INTERESTED
}

// CASE SIGHTINGS (was Sighting)
model CaseSighting {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reportedById    String
  reportedBy      User     @relation(fields: [reportedById], references: [id], onDelete: Cascade)

  // Sighting details
  sightedAt       DateTime
  latitude        Float
  longitude       Float
  address         String
  description     String
  certaintyLevel  Int      // 1-5 scale

  // Media
  photoUrls       String   @default("[]") // JSON: ["url1", "url2", etc]

  // Verification
  isVerified      Boolean  @default(false)
  verifiedBy      String?
  verifiedAt      DateTime?

  createdAt       DateTime @default(now())

  @@index([caseId])
  @@index([latitude, longitude])
}

// CASE UPDATES (was Comment)
model CaseUpdate {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId        String
  author          User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content         String
  isUpdate        Boolean  @default(false)
  isPinned        Boolean  @default(false)

  createdAt       DateTime @default(now())
  editedAt        DateTime?

  @@index([caseId])
}

// ============================================================================
// RESCUE SQUAD SYSTEM
// ============================================================================

model RescueSquad {
  id              String   @id @default(cuid())

  // Rescue Squad Identity
  name            String   @unique // "Chicago Rescue Squad"
  description     String?
  logoUrl         String?
  photoUrl        String?  // Squad profile photo
  slogan          String?  // Custom slogan for the squad
  zipCode         String?  // Primary ZIP code (for display)

  // Location (for browsing/filtering nationally)
  city            String?  // "Chicago", "Los Angeles"
  state           String?  // "IL", "CA", "TX" (2-letter abbreviation)
  zipCodes        String   @default("[]") // JSON array of ZIP codes served

  // Coverage & Specialization
  coverageType    CoverageType @default(RADIUS)
  centerLatitude  Float?
  centerLongitude Float?
  radiusMiles     Int      @default(5)
  customBoundary  String?  // JSON: GeoJSON polygon for custom coverage

  // Specializations
  specializesInDogs    Boolean  @default(true)
  specializesInCats    Boolean  @default(true)
  specializesInBirds   Boolean  @default(false)
  specializesInOther   Boolean  @default(false)
  availableWeekdays    Boolean  @default(true)
  availableWeekends    Boolean  @default(true)
  availableDay         Boolean  @default(true)
  availableNight       Boolean  @default(false)
  hasTrackingDogs      Boolean  @default(false)
  hasDrones            Boolean  @default(false)

  // Status
  isActive        Boolean  @default(true)
  isAcceptingCases Boolean @default(true)

  // Stats (Lifetime)
  totalCasesAccepted   Int      @default(0)
  totalCasesCompleted  Int      @default(0)
  successfulReunions   Int      @default(0)
  totalSearchHours     Float    @default(0)
  totalAcreageSearched Float    @default(0)
  avgResponseTimeMinutes Int?   // Avg time to accept a case

  // Gamification
  rescueSquadLevel RescueSquadLevel @default(ROOKIE)
  squadPoints      Int      @default(0)
  badges           String   @default("[]") // JSON: ["first_reunion", "speed_demon", etc]

  // Relations
  members          RescueSquadMember[]
  caseAssignments  CaseAssignment[]
  divisions        Division[]
  divisionRequests DivisionRequest[]
  cases            LostPetCase[]  // Phase 13-14: Lost Pet Cases MVP
  activities       SquadActivity[]
  tasks            SquadTask[]
  joinRequests     SquadJoinRequest[]
  posts            SquadPost[]      // Community posts

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Soft Delete
  isDeleted       Boolean  @default(false)
  deletedAt       DateTime?

  @@index([isActive, isAcceptingCases])
  @@index([centerLatitude, centerLongitude])
  @@index([state])
  @@index([city])
  @@index([state, city])
  @@index([isDeleted])
}

enum CoverageType {
  RADIUS       // Simple radius from center point
  NEIGHBORHOOD // Specific neighborhood/zip codes
  CUSTOM       // Custom polygon boundary
  CITYWIDE     // Entire city
}

enum RescueSquadLevel {
  ROOKIE       // 0-5 cases
  ACTIVE       // 6-20 cases
  VETERAN      // 21-50 cases
  ELITE        // 51-100 cases
  LEGENDARY    // 100+ cases
}

model RescueSquadMember {
  id              String   @id @default(cuid())
  rescueSquadId   String
  rescueSquad     RescueSquad @relation(fields: [rescueSquadId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Division (optional - only for large cities with divisions)
  divisionId      String?
  division        Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)

  // Role
  role            RescueSquadMemberRole @default(MEMBER)

  // Status
  isActive        Boolean  @default(true)

  // Stats (Within This Rescue Squad)
  casesParticipated Int    @default(0)
  successfulReunions Int   @default(0)
  searchHours     Float    @default(0)
  areasMarked     Int      @default(0)

  // Availability
  availabilityStatus AvailabilityStatus @default(AVAILABLE)
  unavailableUntil DateTime?

  joinedAt        DateTime @default(now())
  leftAt          DateTime?

  @@unique([rescueSquadId, userId])
  @@index([userId])
  @@index([role])
  @@index([isActive])
  @@index([divisionId])
}

enum RescueSquadMemberRole {
  FOUNDER          // Created the rescue squad
  LEADER           // Can accept cases, manage members
  COORDINATOR      // Can coordinate searches, post updates
  MEMBER           // Regular searcher

  // Legacy roles (deprecated, kept for backward compatibility)
  ADMINISTRATOR    // Legacy: equivalent to LEADER
  MODERATOR        // Legacy: equivalent to COORDINATOR
  DIVISION_LEADER  // Legacy: equivalent to LEADER
}

enum AvailabilityStatus {
  AVAILABLE        // Ready to search
  BUSY             // Temporarily unavailable
  AWAY             // Extended absence
}

// CASE ASSIGNMENT (Rescue Squad Accepts Case)
model CaseAssignment {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  rescueSquadId   String
  rescueSquad     RescueSquad @relation(fields: [rescueSquadId], references: [id], onDelete: Cascade)

  // Assignment Status
  status          AssignmentStatus @default(ACCEPTED)
  acceptedAt      DateTime @default(now())
  acceptedById    String   // Rescue Squad leader who accepted

  // Participation
  activeMembers   Int      @default(0)
  searchHours     Float    @default(0)
  areasSearched   Int      @default(0)

  // Completion
  completedAt     DateTime?
  contribution    String?  // "Found pet", "Covered north side", etc.

  // Relations
  participants    CaseParticipant[]
  searchAreas     SearchArea[]
  petSpottings    PetSpotting[]
  messages        SquadMessage[]

  @@unique([caseId, rescueSquadId]) // Rescue Squad can only accept case once
  @@index([caseId])
  @@index([rescueSquadId])
  @@index([status])
}

enum AssignmentStatus {
  ACCEPTED         // Rescue Squad accepted, mobilizing
  ACTIVE           // Members actively searching
  STANDBY          // Paused, watching for updates
  COMPLETED        // Rescue Squad finished their involvement
  WITHDRAWN        // Rescue Squad withdrew from case
}

// CASE PARTICIPANT (Rescue Squad Member Opts Into Specific Case)
model CaseParticipant {
  id              String   @id @default(cuid())
  assignmentId    String
  assignment      CaseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Participation
  optedInAt       DateTime @default(now())
  optedOutAt      DateTime?
  isActive        Boolean  @default(true)

  // Contribution
  searchHours     Float    @default(0)
  areasMarked     Int      @default(0)
  sightingsReported Int    @default(0)

  // Volunteer Coordination
  searchSessions  SearchSession[]

  @@unique([assignmentId, userId])
  @@index([userId])
  @@index([isActive])
}

// SQUAD MESSAGE (Case-specific chat)
model SquadMessage {
  id              String   @id @default(cuid())
  assignmentId    String
  assignment      CaseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  authorId        String
  author          User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Message Type
  type            MessageType @default(CHAT)
  content         String

  // Attachments
  photoUrls       String   @default("[]") // JSON array
  location        String?  // JSON: {lat, lng, address}

  createdAt       DateTime @default(now())
  editedAt        DateTime?

  @@index([assignmentId])
  @@index([createdAt])
}

enum MessageType {
  CHAT            // Regular chat message
  ANNOUNCEMENT    // Leader announcement
  SYSTEM          // System-generated message
}

model SearchArea {
  id              String   @id @default(cuid())
  assignmentId    String
  assignment      CaseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  markedById      String
  markedBy        User     @relation(fields: [markedById], references: [id], onDelete: Cascade)

  // Area Details
  geometry        String   // JSON: GeoJSON polygon coordinates
  acreage         Float
  notes           String?
  potentialSpotting Boolean @default(false) // Checkbox: potential pet spotted

  // Metadata
  startAddress    String?  // Starting point of search
  markedAt        DateTime @default(now())

  @@index([assignmentId])
  @@index([markedById])
  @@index([markedAt])
}

model PetSpotting {
  id              String   @id @default(cuid())
  assignmentId    String
  assignment      CaseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  reportedById    String
  reportedBy      User     @relation(fields: [reportedById], references: [id], onDelete: Cascade)

  // Sighting Details
  latitude        Float
  longitude       Float
  address         String?
  spottedAt       DateTime // When they saw the pet
  confidenceLevel Int      // 1-10 scale

  // Media & Notes
  photoUrls       String   @default("[]") // JSON array
  notes           String?

  reportedAt      DateTime @default(now())

  @@index([assignmentId])
  @@index([reportedById])
  @@index([reportedAt])
}

model SquadHonor {
  id              String   @id @default(cuid())
  rescueSquadId   String

  // Who gave and received
  honoredUserId   String
  honoredUser     User     @relation("HonoredUser", fields: [honoredUserId], references: [id], onDelete: Cascade)
  givenById       String   // Pet owner
  givenBy         User     @relation("HonoringUser", fields: [givenById], references: [id], onDelete: Cascade)

  note            String?  // Optional message from owner

  createdAt       DateTime @default(now())

  @@index([honoredUserId])
  @@index([rescueSquadId])
}

// ============================================================================
// SQUAD ACTIVITY & TASK SYSTEM
// ============================================================================

model SquadActivity {
  id              String   @id @default(cuid())
  rescueSquadId   String
  rescueSquad     RescueSquad @relation(fields: [rescueSquadId], references: [id], onDelete: Cascade)

  // Activity type
  type            String   // CASE_ACCEPTED, MEMBER_JOINED, SIGHTING_REPORTED, TASK_CREATED, etc.
  message         String   // Human-readable description
  details         String?  // Additional context

  // Actor
  actorId         String?
  actor           User?    @relation(fields: [actorId], references: [id])

  // Related case (optional)
  caseId          String?

  createdAt       DateTime @default(now())

  @@index([rescueSquadId])
  @@index([type])
  @@index([caseId])
  @@index([createdAt])
}

model SquadTask {
  id              String   @id @default(cuid())
  rescueSquadId   String
  rescueSquad     RescueSquad @relation(fields: [rescueSquadId], references: [id], onDelete: Cascade)

  // Related case
  caseId          String?

  // Action system (links to master action types)
  actionId        String?  // e.g., "call_shelter", "search_area", "litter_outside"

  // Task details
  title           String
  description     String?
  type            String   // SEARCH_AREA, POSTER_DISTRIBUTION, SHELTER_CHECK, FOLLOWUP, OTHER
  priority        String   // LOW, MEDIUM, HIGH, URGENT
  status          String   @default("AVAILABLE") // AVAILABLE, IN_PROGRESS, NEEDS_HELP, COMPLETED, BLOCKED

  // Role-based filtering
  role            String   @default("SQUAD") // OWNER, SQUAD, BOTH
  phase           Int?     // 1, 2, 3, 4, 5 (which phase this task applies to)
  petType         String?  // CAT, DOG, BOTH

  // Priority algorithm score (calculated)
  priorityScore   Int      @default(0) // Higher = more urgent

  // Task type for linking to action definitions (e.g., "search_area", "contact_shelters")
  taskType        String?  // Links to TASK_DEFINITIONS[taskType]

  // Owner-requested task (gets +25% point bonus when completed)
  ownerRequested        Boolean  @default(false)  // For point bonus calculation
  ownerRequestedHelp    Boolean  @default(false)  // Owner explicitly requested help on this task
  ownerRequestedAt      DateTime?
  ownerRequestedMessage String?  // Why owner wants help with this task

  // Location (optional)
  latitude        Float?
  longitude       Float?
  address         String?

  // Shelter reference (for shelter call tasks)
  shelterId       String?
  shelter         Shelter? @relation(fields: [shelterId], references: [id])

  // Collaboration (multiple people can work on same task)
  needsHelp       Boolean  @default(false)
  blockedReason   String?  // Why task is blocked (e.g., "Shelter closed")
  participants    TaskParticipant[]

  // Legacy assignment (keeping for backwards compatibility)
  assignedToId    String?
  assignedTo      User?    @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdById     String
  createdBy       User     @relation("TaskCreator", fields: [createdById], references: [id])

  // Completion
  completedById   String?
  completedBy     User?    @relation("TaskCompleter", fields: [completedById], references: [id])
  completedAt     DateTime?
  completionNotes String?
  completionResult String? // NO_MATCH, POSSIBLE_MATCH, SUCCESS, FAILED

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([rescueSquadId])
  @@index([caseId])
  @@index([status])
  @@index([role])
  @@index([priorityScore])
  @@index([shelterId])
  @@index([ownerRequested])
  @@index([taskType])
}

// Task collaboration - multiple users can work on same task
model TaskParticipant {
  id          String   @id @default(cuid())
  taskId      String
  task        SquadTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  joinedAt    DateTime @default(now())
  leftAt      DateTime?
  status      String   @default("ACTIVE") // ACTIVE, LEFT, COMPLETED

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

// ============================================================================
// SQUAD COMMUNITY POSTS (Reddit + Facebook style)
// ============================================================================

model SquadPost {
  id              String   @id @default(cuid())
  rescueSquadId   String
  rescueSquad     RescueSquad @relation(fields: [rescueSquadId], references: [id], onDelete: Cascade)

  // Division (optional - for division-specific posts)
  divisionId      String?
  division        Division? @relation("DivisionPosts", fields: [divisionId], references: [id], onDelete: SetNull)

  // Author
  authorId        String
  author          User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Content
  title           String?  // Optional title (Reddit-style)
  content         String   // Main post content
  imageUrl        String?  // Optional image attachment

  // Engagement
  upvotes         Int      @default(0)
  downvotes       Int      @default(0)
  commentCount    Int      @default(0)

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  editedAt        DateTime?

  // Soft Delete
  isDeleted       Boolean  @default(false)
  deletedAt       DateTime?

  // Relations
  comments        SquadPostComment[]
  votes           SquadPostVote[]

  @@index([rescueSquadId, createdAt])
  @@index([divisionId])
  @@index([authorId])
  @@index([createdAt])
  @@index([upvotes])
}

model SquadPostComment {
  id              String   @id @default(cuid())
  postId          String
  post            SquadPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Author
  authorId        String
  author          User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Content
  content         String

  // Threading (Reddit-style nested comments)
  parentCommentId String?
  parentComment   SquadPostComment? @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         SquadPostComment[] @relation("CommentReplies")

  // Engagement
  upvotes         Int      @default(0)
  downvotes       Int      @default(0)

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  editedAt        DateTime?

  // Soft Delete
  isDeleted       Boolean  @default(false)
  deletedAt       DateTime?

  // Relations
  votes           SquadCommentVote[]

  @@index([postId, createdAt])
  @@index([authorId])
  @@index([parentCommentId])
  @@index([createdAt])
}

model SquadPostVote {
  id              String   @id @default(cuid())
  postId          String
  post            SquadPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Vote: 1 for upvote, -1 for downvote
  vote            Int      // 1 or -1

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model SquadCommentVote {
  id              String   @id @default(cuid())
  commentId       String
  comment         SquadPostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Vote: 1 for upvote, -1 for downvote
  vote            Int      // 1 or -1

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

// ============================================================================
// DIVISION SYSTEM (Neighborhood subdivisions within Rescue Squads)
// ============================================================================

model Division {
  id              String   @id @default(cuid())

  // Parent Rescue Squad
  rescueSquadId   String
  rescueSquad     RescueSquad @relation(fields: [rescueSquadId], references: [id], onDelete: Cascade)

  // Division Identity
  name            String   // "North Side", "Downtown", "Lincoln Park"
  description     String?

  // Coverage (neighborhood-level)
  centerLatitude  Float?
  centerLongitude Float?
  radiusMiles     Int      @default(3)  // Smaller than squad-level
  zipCodes        String   @default("[]") // JSON array of zip codes
  customBoundary  String?  // JSON: GeoJSON polygon

  // Status
  isActive        Boolean  @default(true)

  // Soft Delete
  isDeleted       Boolean  @default(false)
  deletedAt       DateTime?

  // Stats
  totalMembers    Int      @default(0)
  activeCases     Int      @default(0)

  // Relations
  members         RescueSquadMember[]
  divisionRequest DivisionRequest?
  posts           SquadPost[] @relation("DivisionPosts")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([rescueSquadId, name]) // Division names unique within squad
  @@index([rescueSquadId])
  @@index([isActive])
  @@index([isDeleted])
}

model DivisionRequest {
  id              String   @id @default(cuid())

  // Requester
  requesterId     String
  requester       User     @relation(fields: [requesterId], references: [id])

  // Request Details
  rescueSquadId   String   // Which squad to add division to
  rescueSquad     RescueSquad @relation(fields: [rescueSquadId], references: [id], onDelete: Cascade)
  proposedName    String   // "North Side", "West End", etc.
  justification   String   // Why this division is needed

  // Geographic Details
  zipCodes        String   @default("[]") // JSON array
  centerLatitude  Float?
  centerLongitude Float?
  estimatedRadius Int?     // Miles

  // Additional Context
  estimatedPopulation Int?
  notes           String?

  // Review Status
  status          RequestStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?    @relation("ReviewedDivisionRequests", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?

  // Approval creates Division
  approvedDivisionId String?  @unique
  approvedDivision Division? @relation(fields: [approvedDivisionId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([requesterId])
  @@index([rescueSquadId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// COMMUNITY SYSTEM (LEGACY - Keeping for backwards compatibility)
// ============================================================================

model CommunityRequest {
  id              String   @id @default(cuid())
  requesterId     String
  requester       User     @relation(fields: [requesterId], references: [id])

  // Request Details
  type            CommunityType
  geographicScope String   // City name or zip code
  notes           String?  // Optional notes from requester
  parentCommunityId String? // For subcommunity requests

  // Review Status
  status          RequestStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?    @relation("ReviewedRequests", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?

  // Approval creates community
  approvedCommunityId String?
  approvedCommunity Community? @relation(fields: [approvedCommunityId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([requesterId])
  @@index([status])
  @@index([createdAt])
}

model Community {
  id              String   @id @default(cuid())

  // Basic Info
  name            String   @unique
  description     String?
  type            CommunityType

  // Geography
  geographicScope String   // Official metro/county/city name
  zipCodes        String   @default("[]") // JSON array of zip codes
  centerLatitude  Float?
  centerLongitude Float?

  // Hierarchy
  parentCommunityId String?
  parentCommunity Community? @relation("CommunityHierarchy", fields: [parentCommunityId], references: [id])
  subcommunities  Community[] @relation("CommunityHierarchy")

  // Status
  isActive        Boolean  @default(true)

  // Creation & Approval
  createdById     String
  createdBy       User     @relation("CommunityCreator", fields: [createdById], references: [id])
  approvedById    String
  approvedBy      User     @relation("CommunityApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime @default(now())

  // Relations
  members         CommunityMember[]
  posts           CommunityPost[]
  requests        CommunityRequest[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([type])
  @@index([parentCommunityId])
  @@index([isActive])
}

model CommunityMember {
  id              String   @id @default(cuid())
  communityId     String
  community       Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Status
  status          MemberStatus @default(PENDING)
  role            CommunityRole @default(MEMBER)

  // Join Request
  requestedAt     DateTime @default(now())
  approvedAt      DateTime?
  approvedById    String?
  rejectedAt      DateTime?
  rejectionReason String?

  // Notifications (JSON for granular settings)
  notificationSettings String @default("{}") // JSON: {newAlerts: true, announcements: false, ...}

  // Special Statuses
  isFounder       Boolean  @default(false)

  // Moderation
  bannedAt        DateTime?
  bannedById      String?
  banReason       String?

  // Daily Post Tracking
  dailyPostCount  Int      @default(0)
  lastPostDate    DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([communityId, userId])
  @@index([userId])
  @@index([status])
  @@index([role])
}

model CommunityPost {
  id              String   @id @default(cuid())
  communityId     String
  community       Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  authorId        String
  author          User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content         String
  isPinned        Boolean  @default(false)
  isDeleted       Boolean  @default(false)
  deletedById     String?
  deletedAt       DateTime?
  deleteReason    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([communityId])
  @@index([authorId])
  @@index([createdAt])
  @@index([isPinned])
}

enum CommunityType {
  METRO_AREA    // Metropolitan area
  COUNTY        // County (for rural areas)
  SUBCOMMUNITY  // City/neighborhood within metro/county
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MemberStatus {
  PENDING
  APPROVED
  REJECTED
  BANNED
}

enum CommunityRole {
  MEMBER
  MODERATOR
}

// ============================================================================
// LOST PET CASE SYSTEM (Phase 13-14 - MVP)
// ============================================================================

model LostPetCase {
  id            String            @id @default(cuid())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  caseNumber    String            @unique

  // Pet info
  petName       String?
  petSpecies    PetSpecies
  petBreed      String?
  petColor      String?
  petDescription String?

  // Location
  city          String
  state         String
  zipCode       String?
  lastSeenLandmark String?
  lastSeenAt    DateTime?

  // Status
  status        LostPetCaseStatus @default(OPEN)
  statusReason  String?
  isUrgent      Boolean           @default(false)

  // Contact
  contactName   String?
  contactPhone  String?
  contactEmail  String?

  // Public Visibility (Phase 15-16)
  isPublic      Boolean           @default(false)
  publicContactOk Boolean         @default(false)
  source        String            @default("ADMIN")  // "ADMIN" or "PUBLIC_REPORT"

  // Phase 1.4: Matching fields
  reportType    String            @default("LOST")   // "LOST" or "FOUND"
  latitude      Float?
  longitude     Float?
  photoUrls     String            @default("[]")     // JSON array of photo URLs

  // Relations
  createdById   String
  createdBy     User              @relation(fields: [createdById], references: [id], onDelete: Cascade)

  squadId       String?
  squad         RescueSquad?      @relation(fields: [squadId], references: [id], onDelete: SetNull)

  // NEW: Optional primary coordinator for this case (Phase 22-24)
  coordinatorId String?
  coordinator   User?             @relation("CaseCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)

  notes         LostPetCaseNote[]
  shelterIntakes ShelterIntake[]

  @@index([city, state])
  @@index([status])
  @@index([squadId])
  @@index([isPublic, status])
  @@index([coordinatorId])
}

model LostPetCaseNote {
  id         String      @id @default(cuid())
  createdAt  DateTime    @default(now())

  caseId     String
  case       LostPetCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  authorId   String
  author     User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  type       String      @default("NOTE")
  content    String
  metadata   String      @default("{}")

  @@index([caseId])
}

// ============================================================================
// PHASE 1: SOCIAL SHARING
// ============================================================================

model ShareEvent {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  caseId      String
  platform    String   // facebook, twitter, nextdoor, whatsapp, email, copy, native
  userId      String?  // Null for anonymous shares
  ipAddress   String?  // For anonymous share tracking
  userAgent   String?

  @@index([caseId])
  @@index([platform])
  @@index([userId])
  @@index([createdAt])
}

// ============================================================================
// PHASE 3: EMAIL PREFERENCES
// ============================================================================

model EmailPreference {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Notification types
  caseUpdates         Boolean @default(true)
  sightingAlerts      Boolean @default(true)
  squadMessages       Boolean @default(true)
  weeklyDigest        Boolean @default(false)
  marketingEmails     Boolean @default(false)
  systemAnnouncements Boolean @default(true)

  // Delivery preferences
  digestFrequency     String  @default("IMMEDIATE") // IMMEDIATE, DAILY, WEEKLY
  quietHoursStart     Int?    // Hour (0-23)
  quietHoursEnd       Int?    // Hour (0-23)
  timezone            String  @default("America/Chicago")

  // Unsubscribe
  unsubscribeToken    String  @unique @default(cuid())
  unsubscribedAt      DateTime?
  unsubscribeReason   String?

  @@index([userId])
}

model EmailLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  userId      String
  emailType   String   // CASE_UPDATE, SIGHTING_ALERT, DIGEST, etc.
  subject     String
  sentTo      String
  status      String   @default("SENT") // SENT, DELIVERED, BOUNCED, FAILED
  messageId   String?  // From email provider
  openedAt    DateTime?
  clickedAt   DateTime?

  @@index([userId])
  @@index([emailType])
  @@index([createdAt])
}

// ============================================================================
// PHASE 6: SMS NOTIFICATIONS
// ============================================================================

model SmsPreference {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  phoneNumber String
  verified    Boolean  @default(false)
  verifyCode  String?
  verifyExpiry DateTime?

  // Notification types
  urgentAlerts    Boolean @default(true)
  sightingAlerts  Boolean @default(false)
  caseUpdates     Boolean @default(false)

  // Limits
  dailyLimit      Int     @default(10)
  sentToday       Int     @default(0)
  lastResetDate   DateTime @default(now())

  @@index([userId])
  @@index([phoneNumber])
}

model SmsLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  userId      String
  phoneNumber String
  messageType String   // URGENT_ALERT, SIGHTING, VERIFICATION
  message     String
  status      String   @default("SENT") // SENT, DELIVERED, FAILED
  twilioSid   String?
  errorCode   String?
  cost        Float?

  @@index([userId])
  @@index([phoneNumber])
  @@index([createdAt])
}

// ============================================================================
// PHASE 8: PUSH NOTIFICATIONS
// ============================================================================

model PushSubscription {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  endpoint    String   @unique
  subscription String  // Full JSON subscription object

  // Device info
  deviceType  String?  // web, ios, android
  deviceName  String?
  browserInfo String?
  userAgent   String?

  // Status
  isActive    Boolean  @default(true)
  lastUsedAt  DateTime @default(now())
  failedCount Int      @default(0)

  @@index([userId])
  @@index([isActive])
}

model PushNotificationLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  userId      String
  title       String
  body        String
  data        String?  // JSON payload
  status      String   @default("SENT") // SENT, DELIVERED, CLICKED, FAILED
  endpoint    String?
  errorMessage String?

  @@index([userId])
  @@index([createdAt])
}

// ============================================================================
// PHASE 9: SHELTER INTEGRATION
// ============================================================================

// City-level cache for shelter data to reduce API calls
model CityCache {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // City identification
  city        String
  state       String
  country     String   @default("US")

  // Geographic data
  centerLat   Float?              // City center latitude
  centerLng   Float?              // City center longitude
  boundary    String?             // GeoJSON polygon of city boundary

  // Cache tracking
  lastFetchedAt   DateTime?       // When shelters were last fetched from API
  shelterCount    Int      @default(0) // Number of shelters found
  fetchSource     String?          // APPLE_MAPKIT, GOOGLE_PLACES, etc.

  // Relations - shelters in this city
  shelters    Shelter[] @relation("CityShelters")

  @@unique([city, state, country])
  @@index([state])
  @@index([lastFetchedAt])
}

model Shelter {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // External IDs (for deduplication)
  appleMapKitId   String?  @unique  // Apple MapKit place ID
  googlePlaceId   String?  @unique  // Google Places ID
  petfinderId     String?  @unique  // PetFinder organization ID

  // Basic info
  name        String
  type        String   @default("SHELTER") // SHELTER, RESCUE, VET, ANIMAL_CONTROL
  apiType     String?  // PETFINDER, RESCUEGROUPS, CUSTOM

  // Location
  address     String
  city        String
  state       String
  zipCode     String
  latitude    Float?
  longitude   Float?
  phone       String?
  email       String?
  website     String?

  // Hours of operation (JSON: {"mon": "9-5", "tue": "9-5", ...})
  hours       String?  // JSON

  // Shelter details
  acceptsStrays Boolean?
  isNoKill      Boolean?

  // Data source tracking
  source      String   @default("MANUAL") // APPLE_MAPKIT, GOOGLE_PLACES, PETFINDER, CROWDSOURCE, MANUAL
  fetchedAt   DateTime?

  // API Integration (for shelters we sync intake data from)
  apiEndpoint String?
  apiKey      String?  // Encrypted
  lastSyncAt  DateTime?
  syncEnabled Boolean  @default(true)

  // Status
  isActive    Boolean  @default(true)
  isVerified  Boolean  @default(false)

  // Relations
  intakes     ShelterIntake[]
  tasks       SquadTask[]
  cityCache   CityCache? @relation("CityShelters", fields: [cityCacheId], references: [id])
  cityCacheId String?

  @@index([city, state])
  @@index([cityCacheId])
  @@index([latitude, longitude])
  @@index([isActive])
  @@index([type])
  @@index([source])
}

model ShelterIntake {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shelterId   String
  shelter     Shelter  @relation(fields: [shelterId], references: [id])

  // Animal info
  externalId  String?  // ID from shelter system
  species     String
  breed       String?
  color       String?
  size        String?
  name        String?
  description String?
  photoUrls   String   @default("[]") // JSON array

  // Intake details
  intakeDate  DateTime
  intakeType  String?  // STRAY, SURRENDER, TRANSFER
  location    String?  // Where found

  // Status
  status      String   @default("AVAILABLE") // AVAILABLE, ADOPTED, TRANSFERRED, EUTHANIZED, RECLAIMED
  statusDate  DateTime @default(now())

  // Matching
  matchedCaseId String?
  matchedCase   LostPetCase? @relation(fields: [matchedCaseId], references: [id], onDelete: SetNull)
  matchScore    Float?
  matchedAt     DateTime?
  matchStatus   String?  // PENDING, CONFIRMED, REJECTED

  @@unique([shelterId, externalId])
  @@index([shelterId])
  @@index([species])
  @@index([status])
  @@index([intakeDate])
}

// ============================================================================
// PHASE 10: ANALYTICS
// ============================================================================

model AnalyticsEvent {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  eventType   String   // PAGE_VIEW, CASE_VIEW, SEARCH, SIGNUP, etc.
  userId      String?
  sessionId   String?
  ipAddress   String?

  // Event data
  page        String?
  referrer    String?
  userAgent   String?
  metadata    String   @default("{}") // JSON

