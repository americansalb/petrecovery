model MissionThankYou {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())

  missionId       String
  mission         MissionControl @relation(fields: [missionId], references: [id], onDelete: Cascade)

  message         String
  photoUrl        String?
  sentAt          DateTime

