// PetRecovery.org Database Schema - Rescue Squad Model
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE USER SYSTEM
// ============================================================================

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  emailVerified   DateTime?
  phone           String?
  phoneVerified   Boolean  @default(false)
  firstName       String
  lastName        String?
  passwordHash    String?  // Null for quick signup
  role            UserRole @default(USER)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastActive      DateTime @default(now())

  // Rescue Gamification Stats
  rescueLevel     RescueLevel @default(PET_OWNER)
  squadsJoinedCount Int      @default(0)
  areasMarkedCount Int       @default(0)
  totalAcreageSearched Float @default(0)
  successfulReunions Int     @default(0)
  honorsReceived  Int         @default(0)
  lastLevelUpAt   DateTime?

  // Relations
  profile         UserProfile?
  patrolProfile   PatrolProfile?
  pets            Pet[]
  cases           Case[]
  alerts          Alert[]
  caseSightings   CaseSighting[]
  caseUpdates     CaseUpdate[]

  // Rescue Squad Relations
  rescueSquadMemberships RescueSquadMember[]
  caseParticipations     CaseParticipant[]
  searchAreas            SearchArea[]
  petSpottings           PetSpotting[]
  squadMessages          SquadMessage[]
  receivedHonors         SquadHonor[] @relation("HonoredUser")
  givenHonors            SquadHonor[] @relation("HonoringUser")

  // Division Relations
  divisionRequests       DivisionRequest[]
  reviewedDivisionRequests DivisionRequest[] @relation("ReviewedDivisionRequests")

  // Community Relations (LEGACY - keeping for backwards compatibility)
  communityRequests CommunityRequest[]
  reviewedRequests CommunityRequest[] @relation("ReviewedRequests")
  communityMemberships CommunityMember[]
  createdCommunities Community[] @relation("CommunityCreator")
  approvedCommunities Community[] @relation("CommunityApprover")
  communityPosts  CommunityPost[]

  @@index([email])
  @@index([rescueLevel])
}

enum UserRole {
  USER
  PATROL
  MODERATOR
  ADMIN
}

enum RescueLevel {
  PET_OWNER    // Level 0: Submitted a lost pet request
  SCOUT        // Level 1: Joined a rescue squad
  SENTRY       // Level 2: Participated in first case
  SHEPHERD     // Level 3: Marked 5+ areas, 15+ acres total
  PATHFINDER   // Level 4: 1+ successful reunion
  PACK_GUARDIAN // Level 5: 5+ successful reunions
  PACK_LEGEND  // Level 6: 50+ successful reunions
}

model UserProfile {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Location
  latitude        Float?
  longitude       Float?
  address         String?
  city            String?
  state           String?
  zip             String?
  country         String   @default("US")

  // Preferences
  timezone        String   @default("America/Chicago")
  notificationsEnabled Boolean @default(true)

  updatedAt       DateTime @updatedAt

  @@index([latitude, longitude])
}

// RECOVERY PATROL SYSTEM (keeping for backwards compatibility)
model PatrolProfile {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Status
  isActive        Boolean  @default(true)
  isPaused        Boolean  @default(false)

  // Coverage
  radiusMiles     Int      @default(5)
  maxActiveSearches Int    @default(3)

  // Availability (stored as JSON strings for SQLite compatibility)
  availability    String   @default("[]") // JSON: ["weekday_morning", "weekday_evening", "weekend_morning", "weekend_evening"]
  transportation  String   @default("[]") // JSON: ["foot", "bike", "car"]

  // Pet preferences
  searchesDogs    Boolean  @default(true)
  searchesCats    Boolean  @default(true)
  searchesBirds   Boolean  @default(false)
  searchesOther   Boolean  @default(false)

  // Notification preferences
  alertMethod     AlertMethod @default(EMAIL)
  quietHoursStart Int?     // Hour (0-23)
  quietHoursEnd   Int?     // Hour (0-23)
  instantAlerts   Boolean  @default(true)

  // Stats
  joinedAt        DateTime @default(now())
  searchCount     Int      @default(0)
  recoveryCount   Int      @default(0)

  // Gamification
  points          Int      @default(0)
  level           PatrolLevel @default(ROOKIE)

  updatedAt       DateTime @updatedAt
}

enum AlertMethod {
  EMAIL
  SMS
  PUSH
  ALL
}

enum PatrolLevel {
  ROOKIE      // 0 recoveries
  SCOUT       // 1 recovery
  TRACKER     // 5 recoveries
  EXPERT      // 10 recoveries
  LEGEND      // 25+ recoveries
}

// ============================================================================
// PET SYSTEM
// ============================================================================

model Pet {
  id              String   @id @default(cuid())
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Basic info
  name            String
  species         PetSpecies
  breed           String?
  age             Int?
  sex             PetSex?
  isNeutered      Boolean  @default(false)

  // Physical description
  color           String
  size            PetSize
  weight          Float?
  distinctiveMarks String?

  // Identification
  microchipId     String?
  collarInfo      String?

  // Behavior
  personality     String   @default("[]") // JSON: ["friendly", "shy", etc]
  medicalConditions String?

  // Media
  photos          String   @default("[]") // JSON: ["url1", "url2", etc]
  primaryPhotoUrl String

  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  cases           Case[]

  @@index([ownerId])
}

enum PetSpecies {
  DOG
  CAT
  BIRD
  RABBIT
  OTHER
}

enum PetSex {
  MALE
  FEMALE
  UNKNOWN
}

enum PetSize {
  TINY     // < 10 lbs
  SMALL    // 10-25 lbs
  MEDIUM   // 25-60 lbs
  LARGE    // 60-90 lbs
  GIANT    // > 90 lbs
}

// ============================================================================
// CASE SYSTEM (was LostReport)
// ============================================================================

model Case {
  id              String   @id @default(cuid())
  caseNumber      String   @unique // "CHI-2024-001847"

  // Pet Information (denormalized for performance)
  petId           String?  // Optional reference to Pet
  pet             Pet?     @relation(fields: [petId], references: [id])
  petName         String
  petSpecies      PetSpecies
  petBreed        String?
  petColor        String
  petSize         PetSize
  petPhotoUrl     String
  petDescription  String   // Full description

  // Reporter/Owner
  reporterId      String
  reporter        User     @relation(fields: [reporterId], references: [id])
  ownerName       String
  ownerPhone      String
  ownerEmail      String

  // Case Details
  reportType      ReportType @default(LOST)
  status          CaseStatus @default(ACTIVE)
  priority        CasePriority @default(NORMAL)

  // Location
  lastSeenAt      DateTime
  lastSeenLatitude Float
  lastSeenLongitude Float
  lastSeenAddress String
  searchRadius    Float    @default(5) // Miles

  // Incident
  escapeScenario  String
  escapeDetails   String?

  // Meta Ads Integration
  metaAdCampaignId String?
  metaAdBudget    Float?
  metaAdStatus    String?  // "running", "paused", "completed"

  // Reward
  hasReward       Boolean  @default(false)
  rewardAmount    Float?

  // Engagement Metrics
  viewCount       Int      @default(0)
  shareCount      Int      @default(0)
  activeSearchers Int      @default(0)

  // Resolution
  resolvedAt      DateTime?
  resolution      CaseResolution?
  resolutionNotes String?
  foundById       String?

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiresAt       DateTime?

  // Relations
  assignments     CaseAssignment[]
  sightings       CaseSighting[]
  updates         CaseUpdate[]
  alerts          Alert[]

  @@index([status])
  @@index([caseNumber])
  @@index([lastSeenLatitude, lastSeenLongitude])
  @@index([createdAt])
}

enum ReportType {
  LOST    // Owner reporting their lost pet
  FOUND   // Someone reporting they found a pet
}

enum CaseStatus {
  ACTIVE           // Just reported, awaiting rescue squad acceptance
  IN_PROGRESS      // One or more rescue squads actively searching
  SIGHTING_REPORTED // Pet has been sighted
  REUNITED         // Pet found and returned to owner
  CLOSED_OTHER     // Closed for other reasons
}

enum CasePriority {
  LOW              // Adult healthy pet, good weather
  NORMAL           // Standard case
  HIGH             // Medical needs, extreme weather, dangerous area
  URGENT           // Life-threatening situation
}

enum CaseResolution {
  REUNITED         // Found by organized search
  FOUND_BY_OWNER   // Owner found pet themselves
  FOUND_AT_SHELTER // Brought to shelter
  CAME_HOME        // Pet returned on its own
  DECEASED         // Pet found deceased
  SEARCH_CEASED    // Owner stopped searching
}

// ALERT SYSTEM
model Alert {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])

  // Delivery
  method          AlertMethod
  sentAt          DateTime @default(now())
  deliveredAt     DateTime?
  openedAt        DateTime?

  // Response
  respondedAt     DateTime?
  response        AlertResponse?
  responseNote    String?

  @@index([caseId])
  @@index([userId])
  @@index([sentAt])
}

enum AlertResponse {
  WILL_SEARCH
  CANT_NOW
  WATCHING
  NOT_INTERESTED
}

// CASE SIGHTINGS (was Sighting)
model CaseSighting {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id])
  reportedById    String
  reportedBy      User     @relation(fields: [reportedById], references: [id])

  // Sighting details
  sightedAt       DateTime
  latitude        Float
  longitude       Float
  address         String
  description     String
  certaintyLevel  Int      // 1-5 scale

  // Media
  photoUrls       String   @default("[]") // JSON: ["url1", "url2", etc]

  // Verification
  isVerified      Boolean  @default(false)
  verifiedBy      String?
  verifiedAt      DateTime?

  createdAt       DateTime @default(now())

  @@index([caseId])
  @@index([latitude, longitude])
}

// CASE UPDATES (was Comment)
model CaseUpdate {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id])
  authorId        String
  author          User     @relation(fields: [authorId], references: [id])

  content         String
  isUpdate        Boolean  @default(false)
  isPinned        Boolean  @default(false)

  createdAt       DateTime @default(now())
  editedAt        DateTime?

  @@index([caseId])
}

// ============================================================================
// RESCUE SQUAD SYSTEM
// ============================================================================

model RescueSquad {
  id              String   @id @default(cuid())

  // Rescue Squad Identity
  name            String   @unique // "Chicago Rescue Squad"
  description     String?
  logoUrl         String?

  // Location (for browsing/filtering nationally)
  city            String?  // "Chicago", "Los Angeles"
  state           String?  // "IL", "CA", "TX" (2-letter abbreviation)
  zipCodes        String   @default("[]") // JSON array of ZIP codes served

  // Coverage & Specialization
  coverageType    CoverageType @default(RADIUS)
  centerLatitude  Float?
  centerLongitude Float?
  radiusMiles     Int      @default(5)
  customBoundary  String?  // JSON: GeoJSON polygon for custom coverage

  // Specializations
  specializesInDogs    Boolean  @default(true)
  specializesInCats    Boolean  @default(true)
  specializesInBirds   Boolean  @default(false)
  specializesInOther   Boolean  @default(false)
  availableWeekdays    Boolean  @default(true)
  availableWeekends    Boolean  @default(true)
  availableDay         Boolean  @default(true)
  availableNight       Boolean  @default(false)
  hasTrackingDogs      Boolean  @default(false)
  hasDrones            Boolean  @default(false)

  // Status
  isActive        Boolean  @default(true)
  isAcceptingCases Boolean @default(true)

  // Stats (Lifetime)
  totalCasesAccepted   Int      @default(0)
  totalCasesCompleted  Int      @default(0)
  successfulReunions   Int      @default(0)
  totalSearchHours     Float    @default(0)
  totalAcreageSearched Float    @default(0)
  avgResponseTimeMinutes Int?   // Avg time to accept a case

  // Gamification
  rescueSquadLevel RescueSquadLevel @default(ROOKIE)
  squadPoints      Int      @default(0)
  badges           String   @default("[]") // JSON: ["first_reunion", "speed_demon", etc]

  // Relations
  members          RescueSquadMember[]
  caseAssignments  CaseAssignment[]
  divisions        Division[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive, isAcceptingCases])
  @@index([centerLatitude, centerLongitude])
  @@index([state])
  @@index([city])
  @@index([state, city])
}

enum CoverageType {
  RADIUS       // Simple radius from center point
  NEIGHBORHOOD // Specific neighborhood/zip codes
  CUSTOM       // Custom polygon boundary
  CITYWIDE     // Entire city
}

enum RescueSquadLevel {
  ROOKIE       // 0-5 cases
  ACTIVE       // 6-20 cases
  VETERAN      // 21-50 cases
  ELITE        // 51-100 cases
  LEGENDARY    // 100+ cases
}

model RescueSquadMember {
  id              String   @id @default(cuid())
  rescueSquadId   String
  rescueSquad     RescueSquad @relation(fields: [rescueSquadId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Division (optional - only for large cities with divisions)
  divisionId      String?
  division        Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)

  // Role
  role            RescueSquadMemberRole @default(MEMBER)

  // Status
  isActive        Boolean  @default(true)

  // Stats (Within This Rescue Squad)
  casesParticipated Int    @default(0)
  successfulReunions Int   @default(0)
  searchHours     Float    @default(0)
  areasMarked     Int      @default(0)

  // Availability
  availabilityStatus AvailabilityStatus @default(AVAILABLE)
  unavailableUntil DateTime?

  joinedAt        DateTime @default(now())
  leftAt          DateTime?

  @@unique([rescueSquadId, userId])
  @@index([userId])
  @@index([role])
  @@index([isActive])
  @@index([divisionId])
}

enum RescueSquadMemberRole {
  FOUNDER          // Created the rescue squad
  LEADER           // Can accept cases, manage members
  COORDINATOR      // Can coordinate searches, post updates
  MEMBER           // Regular searcher
}

enum AvailabilityStatus {
  AVAILABLE        // Ready to search
  BUSY             // Temporarily unavailable
  AWAY             // Extended absence
}

// CASE ASSIGNMENT (Rescue Squad Accepts Case)
model CaseAssignment {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  rescueSquadId   String
  rescueSquad     RescueSquad @relation(fields: [rescueSquadId], references: [id], onDelete: Cascade)

  // Assignment Status
  status          AssignmentStatus @default(ACCEPTED)
  acceptedAt      DateTime @default(now())
  acceptedById    String   // Rescue Squad leader who accepted

  // Participation
  activeMembers   Int      @default(0)
  searchHours     Float    @default(0)
  areasSearched   Int      @default(0)

  // Completion
  completedAt     DateTime?
  contribution    String?  // "Found pet", "Covered north side", etc.

  // Relations
  participants    CaseParticipant[]
  searchAreas     SearchArea[]
  petSpottings    PetSpotting[]
  messages        SquadMessage[]

  @@unique([caseId, rescueSquadId]) // Rescue Squad can only accept case once
  @@index([caseId])
  @@index([rescueSquadId])
  @@index([status])
}

enum AssignmentStatus {
  ACCEPTED         // Rescue Squad accepted, mobilizing
  ACTIVE           // Members actively searching
  STANDBY          // Paused, watching for updates
  COMPLETED        // Rescue Squad finished their involvement
  WITHDRAWN        // Rescue Squad withdrew from case
}

// CASE PARTICIPANT (Rescue Squad Member Opts Into Specific Case)
model CaseParticipant {
  id              String   @id @default(cuid())
  assignmentId    String
  assignment      CaseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id])

  // Participation
  optedInAt       DateTime @default(now())
  optedOutAt      DateTime?
  isActive        Boolean  @default(true)

  // Contribution
  searchHours     Float    @default(0)
  areasMarked     Int      @default(0)
  sightingsReported Int    @default(0)

  @@unique([assignmentId, userId])
  @@index([userId])
  @@index([isActive])
}

// SQUAD MESSAGE (Case-specific chat)
model SquadMessage {
  id              String   @id @default(cuid())
  assignmentId    String
  assignment      CaseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  authorId        String
  author          User     @relation(fields: [authorId], references: [id])

  // Message Type
  type            MessageType @default(CHAT)
  content         String

  // Attachments
  photoUrls       String   @default("[]") // JSON array
  location        String?  // JSON: {lat, lng, address}

  createdAt       DateTime @default(now())
  editedAt        DateTime?

  @@index([assignmentId])
  @@index([createdAt])
}

enum MessageType {
  CHAT            // Regular chat message
  ANNOUNCEMENT    // Leader announcement
  SYSTEM          // System-generated message
}

model SearchArea {
  id              String   @id @default(cuid())
  assignmentId    String
  assignment      CaseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  markedById      String
  markedBy        User     @relation(fields: [markedById], references: [id])

  // Area Details
  geometry        String   // JSON: GeoJSON polygon coordinates
  acreage         Float
  notes           String?
  potentialSpotting Boolean @default(false) // Checkbox: potential pet spotted

  // Metadata
  startAddress    String?  // Starting point of search
  markedAt        DateTime @default(now())

  @@index([assignmentId])
  @@index([markedById])
  @@index([markedAt])
}

model PetSpotting {
  id              String   @id @default(cuid())
  assignmentId    String
  assignment      CaseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  reportedById    String
  reportedBy      User     @relation(fields: [reportedById], references: [id])

  // Sighting Details
  latitude        Float
  longitude       Float
  address         String?
  spottedAt       DateTime // When they saw the pet
  confidenceLevel Int      // 1-10 scale

  // Media & Notes
  photoUrls       String   @default("[]") // JSON array
  notes           String?

  reportedAt      DateTime @default(now())

  @@index([assignmentId])
  @@index([reportedById])
  @@index([reportedAt])
}

model SquadHonor {
  id              String   @id @default(cuid())
  rescueSquadId   String

  // Who gave and received
  honoredUserId   String
  honoredUser     User     @relation("HonoredUser", fields: [honoredUserId], references: [id])
  givenById       String   // Pet owner
  givenBy         User     @relation("HonoringUser", fields: [givenById], references: [id])

  note            String?  // Optional message from owner

  createdAt       DateTime @default(now())

  @@index([honoredUserId])
  @@index([rescueSquadId])
}

// ============================================================================
// DIVISION SYSTEM (Neighborhood subdivisions within Rescue Squads)
// ============================================================================

model Division {
  id              String   @id @default(cuid())

  // Parent Rescue Squad
  rescueSquadId   String
  rescueSquad     RescueSquad @relation(fields: [rescueSquadId], references: [id], onDelete: Cascade)

  // Division Identity
  name            String   // "North Side", "Downtown", "Lincoln Park"
  description     String?

  // Coverage (neighborhood-level)
  centerLatitude  Float?
  centerLongitude Float?
  radiusMiles     Int      @default(3)  // Smaller than squad-level
  zipCodes        String   @default("[]") // JSON array of zip codes
  customBoundary  String?  // JSON: GeoJSON polygon

  // Status
  isActive        Boolean  @default(true)

  // Stats
  totalMembers    Int      @default(0)
  activeCases     Int      @default(0)

  // Relations
  members         RescueSquadMember[]
  divisionRequest DivisionRequest?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([rescueSquadId, name]) // Division names unique within squad
  @@index([rescueSquadId])
  @@index([isActive])
}

model DivisionRequest {
  id              String   @id @default(cuid())

  // Requester
  requesterId     String
  requester       User     @relation(fields: [requesterId], references: [id])

  // Request Details
  rescueSquadId   String   // Which squad to add division to
  proposedName    String   // "North Side", "West End", etc.
  justification   String   // Why this division is needed

  // Geographic Details
  zipCodes        String   @default("[]") // JSON array
  centerLatitude  Float?
  centerLongitude Float?
  estimatedRadius Int?     // Miles

  // Additional Context
  estimatedPopulation Int?
  notes           String?

  // Review Status
  status          RequestStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?    @relation("ReviewedDivisionRequests", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?

  // Approval creates Division
  approvedDivisionId String?  @unique
  approvedDivision Division? @relation(fields: [approvedDivisionId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([requesterId])
  @@index([rescueSquadId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// COMMUNITY SYSTEM (LEGACY - Keeping for backwards compatibility)
// ============================================================================

model CommunityRequest {
  id              String   @id @default(cuid())
  requesterId     String
  requester       User     @relation(fields: [requesterId], references: [id])

  // Request Details
  type            CommunityType
  geographicScope String   // City name or zip code
  notes           String?  // Optional notes from requester
  parentCommunityId String? // For subcommunity requests

  // Review Status
  status          RequestStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?    @relation("ReviewedRequests", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?

  // Approval creates community
  approvedCommunityId String?
  approvedCommunity Community? @relation(fields: [approvedCommunityId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([requesterId])
  @@index([status])
  @@index([createdAt])
}

model Community {
  id              String   @id @default(cuid())

  // Basic Info
  name            String   @unique
  description     String?
  type            CommunityType

  // Geography
  geographicScope String   // Official metro/county/city name
  zipCodes        String   @default("[]") // JSON array of zip codes
  centerLatitude  Float?
  centerLongitude Float?

  // Hierarchy
  parentCommunityId String?
  parentCommunity Community? @relation("CommunityHierarchy", fields: [parentCommunityId], references: [id])
  subcommunities  Community[] @relation("CommunityHierarchy")

  // Status
  isActive        Boolean  @default(true)

  // Creation & Approval
  createdById     String
  createdBy       User     @relation("CommunityCreator", fields: [createdById], references: [id])
  approvedById    String
  approvedBy      User     @relation("CommunityApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime @default(now())

  // Relations
  members         CommunityMember[]
  posts           CommunityPost[]
  requests        CommunityRequest[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([type])
  @@index([parentCommunityId])
  @@index([isActive])
}

model CommunityMember {
  id              String   @id @default(cuid())
  communityId     String
  community       Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Status
  status          MemberStatus @default(PENDING)
  role            CommunityRole @default(MEMBER)

  // Join Request
  requestedAt     DateTime @default(now())
  approvedAt      DateTime?
  approvedById    String?
  rejectedAt      DateTime?
  rejectionReason String?

  // Notifications (JSON for granular settings)
  notificationSettings String @default("{}") // JSON: {newAlerts: true, announcements: false, ...}

  // Special Statuses
  isFounder       Boolean  @default(false)

  // Moderation
  bannedAt        DateTime?
  bannedById      String?
  banReason       String?

  // Daily Post Tracking
  dailyPostCount  Int      @default(0)
  lastPostDate    DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([communityId, userId])
  @@index([userId])
  @@index([status])
  @@index([role])
}

model CommunityPost {
  id              String   @id @default(cuid())
  communityId     String
  community       Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  authorId        String
  author          User     @relation(fields: [authorId], references: [id])

  content         String
  isPinned        Boolean  @default(false)
  isDeleted       Boolean  @default(false)
  deletedById     String?
  deletedAt       DateTime?
  deleteReason    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([communityId])
  @@index([authorId])
  @@index([createdAt])
  @@index([isPinned])
}

enum CommunityType {
  METRO_AREA    // Metropolitan area
  COUNTY        // County (for rural areas)
  SUBCOMMUNITY  // City/neighborhood within metro/county
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MemberStatus {
  PENDING
  APPROVED
  REJECTED
  BANNED
}

enum CommunityRole {
  MEMBER
  MODERATOR
}
