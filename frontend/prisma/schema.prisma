  updatedAt       DateTime @updatedAt

  missionId       String
  mission         MissionControl @relation(fields: [missionId], references: [id], onDelete: Cascade)

  // Location
  latitude        Float
  longitude       Float

  // Details
  type            String   @default("HUMANE_TRAP")
  notes           String?

  // Status
  status          String   @default("ACTIVE") // ACTIVE, TRIGGERED, REMOVED

  // Placement
  placedById      String?
  placedAt        DateTime

  // Monitoring
  checkSchedule   String?  // JSON
  lastCheckedAt   DateTime?
  lastCheckedById String?
  assignedToId    String?

