// City-level cache for shelter data to reduce API calls
model CityCache {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // City identification
  city    String
  state   String
  country String @default("US")

  // Geographic data
  centerLat Float? // City center latitude
  centerLng Float? // City center longitude
  boundary  String? // GeoJSON polygon of city boundary

  // Cache tracking
  lastFetchedAt DateTime? // When shelters were last fetched from API
  shelterCount  Int       @default(0) // Number of shelters found
  fetchSource   String? // APPLE_MAPKIT, GOOGLE_PLACES, etc.

  // Relations - shelters in this city
  shelters Shelter[] @relation("CityShelters")

  @@unique([city, state, country])
  @@index([state])
  @@index([lastFetchedAt])
}

model Shelter {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // External IDs (for deduplication)
  appleMapKitId String? @unique // Apple MapKit place ID
  googlePlaceId String? @unique // Google Places ID
  petfinderId   String? @unique // PetFinder organization ID

  // Basic info
  name    String
  type    String  @default("SHELTER") // SHELTER, RESCUE, VET, ANIMAL_CONTROL
  apiType String? // PETFINDER, RESCUEGROUPS, CUSTOM

  // Location
  address   String
  city      String
  state     String
  zipCode   String
  latitude  Float?
  longitude Float?
  phone     String?
  email     String?
  website   String?

  // Hours of operation (JSON: {"mon": "9-5", "tue": "9-5", ...})
  hours String? // JSON

  // Shelter details
  acceptsStrays Boolean?
  isNoKill      Boolean?

  // Data source tracking
  source    String    @default("MANUAL") // APPLE_MAPKIT, GOOGLE_PLACES, PETFINDER, CROWDSOURCE, MANUAL
  fetchedAt DateTime?

  // API Integration (for shelters we sync intake data from)
  apiEndpoint String?
  apiKey      String? // Encrypted
  lastSyncAt  DateTime?
  syncEnabled Boolean   @default(true)

  // Status
  isActive   Boolean @default(true)
  isVerified Boolean @default(false)

  // Relations
  intakes     ShelterIntake[]
  tasks       SquadTask[]
  managedPets Pet[]           @relation("ShelterManagedPets")
  cityCache   CityCache?      @relation("CityShelters", fields: [cityCacheId], references: [id])
  cityCacheId String?

  @@index([city, state])
  @@index([cityCacheId])
  @@index([latitude, longitude])
  @@index([isActive])
  @@index([type])
  @@index([source])
}

model ShelterIntake {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shelterId String
  shelter   Shelter @relation(fields: [shelterId], references: [id])

  // Animal info
  externalId  String? // ID from shelter system
  species     String
  breed       String?
  color       String?
  size        String?
  name        String?
  description String?
  photoUrls   String  @default("[]") // JSON array

  // Intake details
  intakeDate DateTime
  intakeType String? // STRAY, SURRENDER, TRANSFER
  location   String? // Where found

  // Status
  status     String   @default("AVAILABLE") // AVAILABLE, ADOPTED, TRANSFERRED, EUTHANIZED, RECLAIMED
  statusDate DateTime @default(now())

  // Matching
  matchedCaseId String?
  matchScore    Float?
  matchedAt     DateTime?
  matchStatus   String? // PENDING, CONFIRMED, REJECTED

  @@unique([shelterId, externalId])
  @@index([shelterId])
  @@index([species])
  @@index([status])
  @@index([intakeDate])
}

// Local community groups (Facebook lost-pet groups etc.) discovered by the
// share_targets cascade action. Works like the Shelter directory: discovered
// once per area, then served from here so repeat cases in the same city cost
// zero search queries and zero AI tokens. Rows go STALE (never served, kept
// for audit) when a fresh sweep of their area no longer finds them.
model CommunityGroup {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kind String @default("FACEBOOK_GROUP")
  slug String @unique // facebook.com/groups/<slug>, the dedupe key
  url  String
  name String

  // LOST_PET = lost-and-found/pet group; COMMUNITY = broad local group
  // (town chatter, community board) worth posting a case to.
  category String @default("LOST_PET")

  // The area the group itself serves, as extracted from its public listing:
  // a short human label ("Kane County, IL" or "Algonquin, LITH, Huntley,
  // Dundee") plus the individual towns as a JSON array for search/filtering.
  coverage String @default("")
  cities   String @default("[]") // JSON array

  // Coordinates of the swept area (the case's last-seen point, or the
  // admin's picked city) so the coverage map can plot where groups exist.
  areaLat Float?
  areaLng Float?

  // The area whose sweep found this group. A group found by two nearby
  // cities' sweeps lives under whichever searched it most recently.
  city  String
  state String

  source      String    @default("CLAUDE_WEB_SEARCH")
  rank        Int       @default(0) // serve order within its area (0 = best)
  fetchedAt   DateTime  @default(now()) // last confirmed by a fresh sweep
  // ACTIVE = serveable. STALE = dropped out of a fresh sweep (or manually
  // aged by an admin); a later sweep can revive it. REMOVED = admin block:
  // never served, never resurrected by sweeps.
  status      String    @default("ACTIVE")
  staleAt     DateTime?
  timesServed Int       @default(0)

  @@index([city, state, status])
  @@index([fetchedAt])
}

