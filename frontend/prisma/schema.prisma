  createdAt       DateTime @default(now())

  missionId       String
  odId            String   // Volunteer device ID

  latitude        Float
  longitude       Float
  accuracy        Float?
  timestamp       DateTime @default(now())

  @@index([missionId])
  @@index([odId])
  @@index([timestamp])
