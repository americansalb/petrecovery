// ============================================================================
// VOLUNTEER COORDINATION SYSTEM (Phases 1-10)
// ============================================================================

model SearchSession {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Participation
  // NOTE: participantId is optional to support direct search sessions without formal RescueSquad membership
  // Points attribution uses userId directly; participantId is for squad coordination features
  participantId   String?
  participant     CaseParticipant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  caseId          String
  divisionId      String?

  // Assignment
  gridCellId      String?
  gridCell        GridCell? @relation(fields: [gridCellId], references: [id])

  // Session Status
  status          String   @default("READY") // READY, ACTIVE, PAUSED, COMPLETED
  startedAt       DateTime?
  endedAt         DateTime?
  pausedAt        DateTime?
  pauseReason     String?
  endReason       String?

  // Location Tracking
  startLocation   String?  // JSON: {lat, lng}
  currentLocation String?  // JSON: {lat, lng, accuracy, heading}
  lastLocationUpdate DateTime?

  // Stats
  totalMinutes    Int      @default(0)

  // Actions v1: Points tracking
  distanceMiles   Float    @default(0)  // Calculated from LocationPings
  pointsEarned    Int      @default(0)  // Points awarded for this session
  isVerified      Boolean  @default(false)  // True if GPS-verified
  userId          String?  // Direct user link for points attribution
  verifiedActionId String? @unique  // Link to VerifiedAction record

  // Location History
  locationPings   LocationPing[]

  @@index([participantId])
  @@index([caseId])
  @@index([status])
  @@index([userId])
}

model LocationPing {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  sessionId   String
  session     SearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  latitude    Float
  longitude   Float
  accuracy    Float?
  heading     Float?

  @@index([sessionId])
  @@index([createdAt])
}

model SearchGrid {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  caseId          String   @unique
  centerLatitude  Float
  centerLongitude Float
  radiusMiles     Float
  cellSizeMeters  Int      @default(100)

  // Stats
  totalCells      Int      @default(0)
  cellsSearched   Int      @default(0)
  lastActivityAt  DateTime?

  // Cells
  cells           GridCell[]

  @@index([caseId])
}

model GridCell {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  gridId          String
  grid            SearchGrid @relation(fields: [gridId], references: [id], onDelete: Cascade)

  // Position
  row             Int
  col             Int
  centerLatitude  Float
  centerLongitude Float
  northLat        Float
  southLat        Float
  eastLng         Float
  westLng         Float

  // Status
  status          String   @default("UNSEARCHED") // UNSEARCHED, IN_PROGRESS, SEARCHED, CLUE_FOUND, NEEDS_REVISIT, PET_FOUND, CLOSED
  priority        Int      @default(5) // 1-10, higher = more important

  // Claim
  claimedById     String?
  claimedAt       DateTime?

  // Search History
  searchedById    String?
  searchedBy      User?    @relation(fields: [searchedById], references: [id])
  searchedAt      DateTime?
  searchCount     Int      @default(0)
  notes           String?

  // Sessions
