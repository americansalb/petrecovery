  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Basic info
  name        String
  type        String   @default("SHELTER") // SHELTER, RESCUE, VET, ANIMAL_CONTROL
  apiType     String?  // PETFINDER, RESCUEGROUPS, CUSTOM

  // Location
  address     String
  city        String
  state       String
  zipCode     String
  latitude    Float?
  longitude   Float?
  phone       String?
  email       String?
  website     String?

  // API Integration
  apiEndpoint String?
  apiKey      String?  // Encrypted
  lastSyncAt  DateTime?
  syncEnabled Boolean  @default(true)

  // Status
  isActive    Boolean  @default(true)
  isVerified  Boolean  @default(false)

  // Relations
  intakes     ShelterIntake[]

  @@index([city, state])
  @@index([isActive])
  @@index([type])
