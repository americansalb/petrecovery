// PetRecovery.org Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// CORE USER SYSTEM
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  emailVerified   DateTime?
  phone           String?
  phoneVerified   Boolean  @default(false)
  firstName       String
  lastName        String?
  passwordHash    String?  // Null for quick signup
  role            UserRole @default(USER)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastActive      DateTime @default(now())

  // Rescue Gamification Stats
  rescueLevel     RescueLevel @default(PET_OWNER)
  squadsJoinedCount Int      @default(0)
  areasMarkedCount Int       @default(0)
  totalAcreageSearched Float @default(0)
  successfulReunions Int     @default(0)
  honorsReceived  Int         @default(0)
  lastLevelUpAt   DateTime?

  // Relations
  profile         UserProfile?
  patrolProfile   PatrolProfile?
  pets            Pet[]
  lostReports     LostReport[]
  alerts          Alert[]
  sightings       Sighting[]
  comments        Comment[]

  // Community Relations
  communityRequests CommunityRequest[]
  reviewedRequests CommunityRequest[] @relation("ReviewedRequests")
  communityMemberships CommunityMember[]
  createdCommunities Community[] @relation("CommunityCreator")
  approvedCommunities Community[] @relation("CommunityApprover")
  communityPosts  CommunityPost[]
  squadMemberships SquadMember[]
  searchAreas     SearchArea[]
  petSpottings    PetSpotting[]
  squadMessages   SquadMessage[]
  receivedHonors  SquadHonor[] @relation("HonoredUser")
  givenHonors     SquadHonor[] @relation("HonoringUser")

  @@index([email])
  @@index([rescueLevel])
}

enum UserRole {
  USER
  PATROL
  MODERATOR
  ADMIN
}

enum RescueLevel {
  PET_OWNER    // Level 0: Submitted a lost pet request
  SCOUT        // Level 1: Joined a community
  SENTRY       // Level 2: Joined a recovery squad
  SHEPHERD     // Level 3: Marked 5+ areas, 15+ acres total
  PATHFINDER   // Level 4: 1+ successful reunion
  PACK_GUARDIAN // Level 5: 5+ successful reunions
  PACK_LEGEND  // Level 6: 50+ successful reunions
}

model UserProfile {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Location
  latitude        Float?
  longitude       Float?
  address         String?
  city            String?
  state           String?
  zip             String?
  country         String   @default("US")

  // Preferences
  timezone        String   @default("America/Chicago")
  notificationsEnabled Boolean @default(true)

  updatedAt       DateTime @updatedAt

  @@index([latitude, longitude])
}

// RECOVERY PATROL SYSTEM
model PatrolProfile {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Status
  isActive        Boolean  @default(true)
  isPaused        Boolean  @default(false)

  // Coverage
  radiusMiles     Int      @default(5)
  maxActiveSearches Int    @default(3)

  // Availability (stored as JSON strings for SQLite compatibility)
  availability    String   @default("[]") // JSON: ["weekday_morning", "weekday_evening", "weekend_morning", "weekend_evening"]
  transportation  String   @default("[]") // JSON: ["foot", "bike", "car"]

  // Pet preferences
  searchesDogs    Boolean  @default(true)
  searchesCats    Boolean  @default(true)
  searchesBirds   Boolean  @default(false)
  searchesOther   Boolean  @default(false)

  // Notification preferences
  alertMethod     AlertMethod @default(EMAIL)
  quietHoursStart Int?     // Hour (0-23)
  quietHoursEnd   Int?     // Hour (0-23)
  instantAlerts   Boolean  @default(true)

  // Stats
  joinedAt        DateTime @default(now())
  searchCount     Int      @default(0)
  recoveryCount   Int      @default(0)

  // Gamification
  points          Int      @default(0)
  level           PatrolLevel @default(ROOKIE)

  updatedAt       DateTime @updatedAt
}

enum AlertMethod {
  EMAIL
  SMS
  PUSH
  ALL
}

enum PatrolLevel {
  ROOKIE      // 0 recoveries
  SCOUT       // 1 recovery
  TRACKER     // 5 recoveries
  EXPERT      // 10 recoveries
  LEGEND      // 25+ recoveries
}

// PET SYSTEM
model Pet {
  id              String   @id @default(cuid())
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Basic info
  name            String
  species         PetSpecies
  breed           String?
  age             Int?
  sex             PetSex?
  isNeutered      Boolean  @default(false)

  // Physical description
  color           String
  size            PetSize
  weight          Float?
  distinctiveMarks String?

  // Identification
  microchipId     String?
  collarInfo      String?

  // Behavior
  personality     String   @default("[]") // JSON: ["friendly", "shy", etc]
  medicalConditions String?

  // Media
  photos          String   @default("[]") // JSON: ["url1", "url2", etc]
  primaryPhotoUrl String

  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  lostReports     LostReport[]

  @@index([ownerId])
}

enum PetSpecies {
  DOG
  CAT
  BIRD
  RABBIT
  OTHER
}

enum PetSex {
  MALE
  FEMALE
  UNKNOWN
}

enum PetSize {
  TINY     // < 10 lbs
  SMALL    // 10-25 lbs
  MEDIUM   // 25-60 lbs
  LARGE    // 60-90 lbs
  GIANT    // > 90 lbs
}

// LOST REPORT SYSTEM
model LostReport {
  id              String   @id @default(cuid())
  petId           String
  pet             Pet      @relation(fields: [petId], references: [id])
  reporterId      String
  reporter        User     @relation(fields: [reporterId], references: [id])

  // Report Type
  reportType      ReportType @default(LOST) // LOST or FOUND

  // Status
  status          ReportStatus @default(ACTIVE)
  priority        Priority @default(NORMAL)

  // Incident details
  lastSeenAt      DateTime
  lastSeenLatitude Float
  lastSeenLongitude Float
  lastSeenAddress String
  escapeScenario  String   // "jumped_fence", "door_left_open", etc
  escapeDetails   String?

  // Search information
  searchRadius    Float    @default(5) // Miles
  aiAdviceGiven   Json?    // Store what advice was shown

  // Reward
  hasReward       Boolean  @default(false)
  rewardAmount    Float?

  // Engagement metrics
  viewCount       Int      @default(0)
  shareCount      Int      @default(0)
  patrolAlerted   Int      @default(0)
  activeSearchers Int      @default(0)

  // Resolution
  foundAt         DateTime?
  foundLatitude   Float?
  foundLongitude  Float?
  foundById       String?
  recoveryStory   String?

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiresAt       DateTime?

  // Relations
  alerts          Alert[]
  sightings       Sighting[]
  comments        Comment[]
  recoverySquads  RecoverySquad[]

  @@index([status])
  @@index([createdAt])
  @@index([lastSeenLatitude, lastSeenLongitude])
}

enum ReportType {
  LOST    // Owner reporting their lost pet
  FOUND   // Someone reporting they found a pet
}

enum ReportStatus {
  DRAFT
  ACTIVE
  SIGHTED
  RECOVERING
  FOUND
  CLOSED
  EXPIRED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ALERT SYSTEM
model Alert {
  id              String   @id @default(cuid())
  reportId        String
  report          LostReport @relation(fields: [reportId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])

  // Delivery
  method          AlertMethod
  sentAt          DateTime @default(now())
  deliveredAt     DateTime?
  openedAt        DateTime?

  // Response
  respondedAt     DateTime?
  response        AlertResponse?
  responseNote    String?

  @@index([reportId])
  @@index([userId])
  @@index([sentAt])
}

enum AlertResponse {
  WILL_SEARCH
  CANT_NOW
  WATCHING
  NOT_INTERESTED
}

// SIGHTINGS
model Sighting {
  id              String   @id @default(cuid())
  reportId        String
  report          LostReport @relation(fields: [reportId], references: [id])
  reportedById    String
  reportedBy      User     @relation(fields: [reportedById], references: [id])

  // Sighting details
  sightedAt       DateTime
  latitude        Float
  longitude       Float
  address         String
  description     String
  certaintyLevel  Int      // 1-5 scale

  // Media
  photoUrls       String   @default("[]") // JSON: ["url1", "url2", etc]

  // Verification
  isVerified      Boolean  @default(false)
  verifiedBy      String?
  verifiedAt      DateTime?

  createdAt       DateTime @default(now())

  @@index([reportId])
  @@index([latitude, longitude])
}

// COMMENTS & UPDATES
model Comment {
  id              String   @id @default(cuid())
  reportId        String
  report          LostReport @relation(fields: [reportId], references: [id])
  authorId        String
  author          User     @relation(fields: [authorId], references: [id])

  content         String
  isUpdate        Boolean  @default(false)
  isPinned        Boolean  @default(false)

  createdAt       DateTime @default(now())
  editedAt        DateTime?

  @@index([reportId])
}

// ============================================================================
// COMMUNITY SYSTEM
// ============================================================================

// COMMUNITY REQUEST & MANAGEMENT
model CommunityRequest {
  id              String   @id @default(cuid())
  requesterId     String
  requester       User     @relation(fields: [requesterId], references: [id])

  // Request Details
  type            CommunityType
  geographicScope String   // City name or zip code
  notes           String?  // Optional notes from requester
  parentCommunityId String? // For subcommunity requests

  // Review Status
  status          RequestStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?    @relation("ReviewedRequests", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?

  // Approval creates community
  approvedCommunityId String?
  approvedCommunity Community? @relation(fields: [approvedCommunityId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([requesterId])
  @@index([status])
  @@index([createdAt])
}

model Community {
  id              String   @id @default(cuid())

  // Basic Info
  name            String   @unique
  description     String?
  type            CommunityType

  // Geography
  geographicScope String   // Official metro/county/city name
  zipCodes        String   @default("[]") // JSON array of zip codes
  centerLatitude  Float?
  centerLongitude Float?

  // Hierarchy
  parentCommunityId String?
  parentCommunity Community? @relation("CommunityHierarchy", fields: [parentCommunityId], references: [id])
  subcommunities  Community[] @relation("CommunityHierarchy")

  // Status
  isActive        Boolean  @default(true)

  // Creation & Approval
  createdById     String
  createdBy       User     @relation("CommunityCreator", fields: [createdById], references: [id])
  approvedById    String
  approvedBy      User     @relation("CommunityApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime @default(now())

  // Relations
  members         CommunityMember[]
  posts           CommunityPost[]
  recoverySquads  RecoverySquad[]
  subsquads       Subsquad[]
  requests        CommunityRequest[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([type])
  @@index([parentCommunityId])
  @@index([isActive])
}

model CommunityMember {
  id              String   @id @default(cuid())
  communityId     String
  community       Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Status
  status          MemberStatus @default(PENDING)
  role            CommunityRole @default(MEMBER)

  // Join Request
  requestedAt     DateTime @default(now())
  approvedAt      DateTime?
  approvedById    String?
  rejectedAt      DateTime?
  rejectionReason String?

  // Notifications (JSON for granular settings)
  notificationSettings String @default("{}") // JSON: {newAlerts: true, announcements: false, ...}

  // Special Statuses
  isFounder       Boolean  @default(false)

  // Moderation
  bannedAt        DateTime?
  bannedById      String?
  banReason       String?

  // Daily Post Tracking
  dailyPostCount  Int      @default(0)
  lastPostDate    DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([communityId, userId])
  @@index([userId])
  @@index([status])
  @@index([role])
}

model CommunityPost {
  id              String   @id @default(cuid())
  communityId     String
  community       Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  authorId        String
  author          User     @relation(fields: [authorId], references: [id])

  content         String
  isPinned        Boolean  @default(false)
  isDeleted       Boolean  @default(false)
  deletedById     String?
  deletedAt       DateTime?
  deleteReason    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([communityId])
  @@index([authorId])
  @@index([createdAt])
  @@index([isPinned])
}

// ============================================================================
// RECOVERY SQUAD SYSTEM
// ============================================================================

model RecoverySquad {
  id              String   @id @default(cuid())
  reportId        String
  report          LostReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  communityId     String
  community       Community @relation(fields: [communityId], references: [id])

  // Squad Info
  name            String   // "{Pet Name} Recovery Squad - {Community Name}"

  // Status
  status          SquadStatus @default(ACTIVE)
  closedAt        DateTime?
  closedReason    SquadClosureReason?

  // Stats
  memberCount     Int      @default(0)
  searchAreasMarked Int    @default(0)
  totalAcreageSearched Float @default(0)

  // Relations
  members         SquadMember[]
  subsquads       Subsquad[]
  messages        SquadMessage[]
  searchAreas     SearchArea[]
  petSpottings    PetSpotting[]
  honors          SquadHonor[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([reportId])
  @@index([communityId])
  @@index([status])
  @@unique([reportId, communityId]) // One squad per report per community
}

model Subsquad {
  id              String   @id @default(cuid())
  squadId         String
  squad           RecoverySquad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  communityId     String   // Subcommunity
  community       Community @relation(fields: [communityId], references: [id])

  name            String   // e.g., "Evanston Subsquad"

  // Relations
  members         SquadMember[]
  messages        SquadMessage[]

  createdAt       DateTime @default(now())

  @@index([squadId])
  @@index([communityId])
  @@unique([squadId, communityId]) // One subsquad per squad per subcommunity
}

model SquadMember {
  id              String   @id @default(cuid())
  squadId         String
  squad           RecoverySquad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Subsquad Assignment (null if in main squad)
  subsquadId      String?
  subsquad        Subsquad? @relation(fields: [subsquadId], references: [id])

  // Role
  role            SquadRole @default(MEMBER)

  // Activity Tracking (for Shepherd level)
  messagesSent    Int      @default(0)
  areasMarked     Int      @default(0)
  actionsCount    Int      @default(0) // messages + areas + photos + locations

  joinedAt        DateTime @default(now())
  leftAt          DateTime?

  @@unique([squadId, userId])
  @@index([userId])
  @@index([subsquadId])
  @@index([role])
}

model SquadMessage {
  id              String   @id @default(cuid())
  squadId         String
  squad           RecoverySquad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  authorId        String
  author          User     @relation(fields: [authorId], references: [id])

  // Subsquad Channel (null = main squad or Central Hub)
  subsquadId      String?
  subsquad        Subsquad? @relation(fields: [subsquadId], references: [id])

  // Message Type
  type            MessageType @default(CHAT)
  content         String

  // Attachments
  photoUrls       String   @default("[]") // JSON array
  location        String?  // JSON: {lat, lng, address}

  createdAt       DateTime @default(now())
  editedAt        DateTime?

  @@index([squadId])
  @@index([subsquadId])
  @@index([createdAt])
}

model SearchArea {
  id              String   @id @default(cuid())
  squadId         String
  squad           RecoverySquad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  markedById      String
  markedBy        User     @relation(fields: [markedById], references: [id])

  // Area Details
  geometry        String   // JSON: GeoJSON polygon coordinates
  acreage         Float
  notes           String?
  potentialSpotting Boolean @default(false) // Checkbox: potential pet spotted

  // Metadata
  startAddress    String?  // Starting point of search
  markedAt        DateTime @default(now())

  @@index([squadId])
  @@index([markedById])
  @@index([markedAt])
}

model PetSpotting {
  id              String   @id @default(cuid())
  squadId         String
  squad           RecoverySquad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  reportedById    String
  reportedBy      User     @relation(fields: [reportedById], references: [id])

  // Sighting Details
  latitude        Float
  longitude       Float
  address         String?
  spottedAt       DateTime // When they saw the pet
  confidenceLevel Int      // 1-10 scale

  // Media & Notes
  photoUrls       String   @default("[]") // JSON array
  notes           String?

  reportedAt      DateTime @default(now())

  @@index([squadId])
  @@index([reportedById])
  @@index([reportedAt])
}

model SquadHonor {
  id              String   @id @default(cuid())
  squadId         String
  squad           RecoverySquad @relation(fields: [squadId], references: [id], onDelete: Cascade)

  // Who gave and received
  honoredUserId   String
  honoredUser     User     @relation("HonoredUser", fields: [honoredUserId], references: [id])
  givenById       String   // Pet owner
  givenBy         User     @relation("HonoringUser", fields: [givenById], references: [id])

  note            String?  // Optional message from owner

  createdAt       DateTime @default(now())

  @@index([honoredUserId])
  @@index([squadId])
}

// ============================================================================
// ENUMS FOR COMMUNITY SYSTEM
// ============================================================================

enum CommunityType {
  METRO_AREA    // Metropolitan area
  COUNTY        // County (for rural areas)
  SUBCOMMUNITY  // City/neighborhood within metro/county
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MemberStatus {
  PENDING
  APPROVED
  REJECTED
  BANNED
}

enum CommunityRole {
  MEMBER
  MODERATOR
}

enum SquadStatus {
  ACTIVE
  CLOSED
}

enum SquadClosureReason {
  FOUND           // Pet reunited with owner
  CEASED          // Owner ceased search activity
}

enum SquadRole {
  OWNER           // Pet owner (auto)
  LEADER          // Designated by owner
  MEMBER          // Regular volunteer
}

enum MessageType {
  CHAT            // Regular chat message
  ANNOUNCEMENT    // Central Hub announcement (leaders only)
  SYSTEM          // System-generated message
}
