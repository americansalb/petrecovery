# PetRecovery.org - Staging Environment Configuration
# Copy this file to .env.local on staging server and fill in values
# This file serves as a template for staging deployments

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL="postgresql://petrecovery:STAGING_PASSWORD@staging-db:5432/petrecovery_staging"

# =============================================================================
# AUTHENTICATION
# =============================================================================
NEXTAUTH_URL="https://staging.petrecovery.org"
NEXTAUTH_SECRET="generate-unique-staging-secret-32-chars-minimum"

# =============================================================================
# EMAIL
# =============================================================================
# Use a staging email service or sandbox mode
EMAIL_SERVICE="sendgrid"
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="PetRecovery Staging <staging-noreply@petrecovery.org>"
ADMIN_NOTIFICATION_EMAIL="staging-admin@petrecovery.org"

# =============================================================================
# FILE STORAGE
# =============================================================================
# Use separate staging storage zone
BUNNY_STORAGE_ZONE="petrecovery-staging"
BUNNY_API_KEY=""
BUNNY_CDN_URL="https://staging-cdn.petrecovery.org"
BUNNY_STORAGE_URL="https://storage.bunnycdn.com"

# =============================================================================
# RATE LIMITING
# =============================================================================
REDIS_URL="redis://staging-redis:6379"

# =============================================================================
# ERROR TRACKING
# =============================================================================
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG="petrecovery"
SENTRY_PROJECT="petrecovery-staging"

# =============================================================================
# FEATURE FLAGS - Staging can test new features
# =============================================================================
ENABLE_SMS_NOTIFICATIONS="true"
ENABLE_PUSH_NOTIFICATIONS="true"
ENABLE_SHELTER_INTEGRATION="false"

# =============================================================================
# DEPLOYMENT
# =============================================================================
NEXT_PUBLIC_BASE_URL="https://staging.petrecovery.org"
NODE_ENV="production"

# =============================================================================
# OPTIONAL - Enable for testing
# =============================================================================
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
