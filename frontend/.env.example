# PetRecovery.org Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# =============================================================================
# DATABASE (Required)
# =============================================================================
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/petrecovery"

# =============================================================================
# AUTHENTICATION (Required)
# =============================================================================
# NextAuth.js configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-random-string-min-32-chars"

# OAuth Providers (Optional - enable as needed)
# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Apple OAuth
APPLE_ID=""
APPLE_SECRET=""

# =============================================================================
# EMAIL (Required for production)
# =============================================================================
# Email service configuration
EMAIL_SERVICE="gmail"  # gmail, sendgrid, mailgun, etc.
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="ReunitePets <noreply@reunitepets.org>"

# Admin notifications
ADMIN_NOTIFICATION_EMAIL=""

# =============================================================================
# PLATFORM EMAIL - RESEND (Required for Actions v1)
# =============================================================================
# Resend API for verified platform emails (shelter/vet contact)
# Sign up at: https://resend.com
RESEND_API_KEY=""
# Optional: only needed if shelter outreach should send from a different
# address than EMAIL_FROM. Left unset, it now inherits EMAIL_FROM.
RESEND_FROM_EMAIL="ReunitePets <alerts@reunitepets.org>"
# Webhook secret for email event tracking (opens, replies)
RESEND_WEBHOOK_SECRET=""

# =============================================================================
# FILE STORAGE (Required for image uploads)
# =============================================================================
# Bunny.net CDN configuration
BUNNY_STORAGE_ZONE=""
BUNNY_API_KEY=""
BUNNY_CDN_URL=""
BUNNY_STORAGE_URL="https://storage.bunnycdn.com"

# =============================================================================
# SMS NOTIFICATIONS (Optional)
# =============================================================================
# Twilio configuration
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# =============================================================================
# PUSH NOTIFICATIONS (Optional)
# =============================================================================
# Web Push VAPID keys (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@petrecovery.org"

# =============================================================================
# RATE LIMITING (Optional - for production scale)
# =============================================================================
# Redis connection for distributed rate limiting
REDIS_URL=""

# =============================================================================
# RECAPTCHA (Optional - for spam prevention)
# =============================================================================
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# =============================================================================
# AI / LLM (Optional - for Sarama AI guide)
# =============================================================================
# Anthropic API key for Claude Haiku (Sarama AI guide)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# =============================================================================
# EXTERNAL APIS (Optional)
# =============================================================================
# Apple MapKit JS (Primary - 250K free calls/day)
# Generate token at: https://developer.apple.com/account/resources/authkeys/list
# You can either provide a pre-generated JWT token OR the keys to generate one:
#
# Option 1: Pre-generated JWT token (recommended for frontend-only usage)
# Generate at: https://maps.developer.apple.com/token-maker
NEXT_PUBLIC_APPLE_MAPKIT_TOKEN=""
#
# Option 2: Server-side token generation (for dynamic token refresh)
APPLE_MAPKIT_TEAM_ID=""
APPLE_MAPKIT_KEY_ID=""
APPLE_MAPKIT_PRIVATE_KEY=""  # Base64 encoded .p8 file contents

# Petfinder API for shelter enrichment (FREE)
PETFINDER_API_KEY=""
PETFINDER_API_SECRET=""

# Google Places API (Temporary primary for shelter lookup until Apple Maps ready)
# Cost: $17/1000 calls - budget accordingly
GOOGLE_PLACES_API_KEY=""

# Where on Earth, the geo game at /geo (docs/GEO.md)
# Browser key: restrict by HTTP referrer and to the Maps JavaScript API.
# It is sent to the browser by /api/geo/config.
GOOGLE_MAPS_BROWSER_KEY=""
# Server key with the Street View Static API enabled (free metadata probe).
# Falls back to GOOGLE_PLACES_API_KEY if that key has the API enabled.
GOOGLE_STREET_VIEW_API_KEY=""
# Optional: secret for sealed round tokens. NEXTAUTH_SECRET is used otherwise.
GEO_TOKEN_SECRET=""
# Optional, for a deployment that IS the game's site (docs/GEO.md, "Hosting
# on another domain"): set to "geo" and that build has no pet chrome, the
# game's own header instead, and every non-game path redirects to the pet
# site. Leave empty on reunitepets.org.
NEXT_PUBLIC_SITE=""
# Optional: on the shared deployment, hosts that should answer the game's
# short paths (/play, /rooms, /room/<code>, /leaderboard) with redirects
# into /geo, and everything else with a redirect to the pet site.
# Comma-separated. Add each host to the Google browser key's referrers.
GEO_DOMAINS=""
# Optional: the game header's name and where its ReunitePets link goes.
NEXT_PUBLIC_GEO_SITE_NAME=""
NEXT_PUBLIC_GEO_HOME_URL=""

# Geocoding service
GEOCODING_API_KEY=""

# =============================================================================
# ERROR TRACKING (Recommended for production)
# =============================================================================
# Sentry configuration
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================
# Enable/disable features
ENABLE_SMS_NOTIFICATIONS="false"
ENABLE_PUSH_NOTIFICATIONS="false"
ENABLE_SHELTER_INTEGRATION="false"
# Actions v1 (Mission Control redesign with points, verification, leaderboards)
ENABLE_ACTIONS_V1="false"

# =============================================================================
# DEPLOYMENT
# =============================================================================
# Base URL for the application
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Node environment
NODE_ENV="development"

# The header your edge/proxy injects with the real client IP.
# Without this, rate limits key on X-Forwarded-For, which the CLIENT sets:
# a caller varying it per request gets a fresh bucket each time and is never
# limited. Set to whatever your proxy uses (x-real-ip, cf-connecting-ip,
# true-client-ip). Verified bypass: 14/14 requests through with forged
# headers vs 10-then-429 from one honest IP.
RATELIMIT_TRUSTED_IP_HEADER=""
